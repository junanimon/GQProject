  namedVisitChance: 0.4
  seniorName: "\uB9C8\uB974\uD0C0"
  seniorLook:
    label: "\uB9C8\uB974\uD0C0"
    body: {fileID: 4653721254178111242, guid: aaa0c6b6db8bbf344be7a19a29948f4f, type: 3}
    portrait: {fileID: -904879791615126292, guid: a3ebeec1bcc19b548bb0156f9cb159f4, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  npcLooks:
  - label: "\uADF8\uB77C\uD568"
    body: {fileID: 8356359671041212313, guid: e102cd0f402841644bdff140eada4d0e, type: 3}
    portrait: {fileID: -1003848711095669618, guid: 0624ca2b9f544f74b907726f4ecfbb2e, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  intro:
  - speaker: 
    text: "\uBCC0\uACBD\uC758 \uC791\uC740 \uB9C8\uC744, \uB85C\uC6F0. \uBAA8\uD5D8\uAC00\uB4E4\uC758 \uCCAB \uBC1C\uAC78\uC74C\uC774 \uC2DC\uC791\uB418\uB294 \uACF3."
  - speaker: 
    text: "\uC624\uB298\uBD80\uD130 \uB098\uB294 \uC774\uACF3 \uBAA8\uD5D8\uAC00 \uAE38\uB4DC\uC758 \uC2E0\uC785 \uC811\uC218\uC6D0\uC774\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uB124\uAC00 \uC2E0\uC785\uC774\uAD6C\uB098. \uB9C8\uB974\uD0C0\uB2E4. \uC5EC\uAE30 \uC811\uC218 \uB2F4\uB2F9\uC774\uACE0, \uC624\uB298\uBD80\uD130 \uB124 \uC120\uBC30."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC77C\uC740 \uB450 \uAC00\uC9C0\uC57C. \uBC24\uC5D0\uB294 \uC758\uB8B0\uC778\uB4E4\uC774 \uB450\uACE0 \uAC04 \uC758\uB8B0\uC11C\uB97C \uC77D\uACE0 '\uAE38\uB4DC \uAE30\uC785\uB780'\uC744 \uCC44\uC6CC. \uBB34\uC2A8 \uBAAC\uC2A4\uD130\uC778\uC9C0, \uBA87 \uB9C8\uB9AC\uC778\uC9C0. \uB3C4\uAC10 \uBCF4\uACE0 \uB4F1\uAE09\uC774\uB791 \uC5ED\uD560 \uB3C4\uC7A5\uAE4C\uC9C0."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uB0AE\uC5D0\uB294 \uCC3D\uAD6C. \uBAA8\uD5D8\uAC00 \uCE74\uB4DC\uB791 \uC758\uB8B0\uC11C\uB97C \uBCF4\uACE0 \uADDC\uC815\uB300\uB85C \uC2B9\uC778\uD558\uAC70\uB098 \uAC70\uC808\uD574. \uC77C\uC744 \uB9C8\uCE58\uACE0 \uC628 \uB140\uC11D\uB4E4\uC740 \uC99D\uAC70\uBB3C\uC774 \uAC8C\uC2DC\uBCF8\uC774\uB791 \uB9DE\uB294\uC9C0 \uBCF4\uACE0."
  - speaker: "\uB098"
    text: "\uAE30\uC900\uC740\u2026 \uC81C\uAC00 \uBC24\uC5D0 \uC4F4 \uAE30\uC785\uB780\uC778\uAC00\uC694?"
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uADF8\uB798. \uBC24\uC5D0 \uB300\uCDA9 \uC4F0\uBA74 \uB0AE\uC5D0 \uC544\uBB34\uB9AC \uC798\uD574\uB3C4 \uC18C\uC6A9\uC5C6\uC5B4. \uC758\uB8B0\uC778 \uB9D0\uC740 \uBC18\uB9CC \uBBFF\uC5B4. \uD638\uB4E4\uAC11 \uB5A0\uB294 \uC0AC\uB78C\uB3C4, '\uBCC4\uC77C \uC544\uB2C8\uC624' \uD558\uB294 \uC0AC\uB78C\uB3C4 \uC788\uC73C\uB2C8\uAE4C."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\uADF8\uB9AC\uACE0 \uD2C0\uB9AC\uBA74, \uB300\uAC00\uB294 \uB124\uAC00 \uC544\uB2C8\uB77C \uBAA8\uD5D8\uAC00\uB4E4\uC774 \uCE58\uB7EC. \uBA85\uC2EC\uD574."
  - speaker: 
    text: "\uC120\uBC30\uB294 \uC11C\uB958 \uBB49\uCE58\uB97C \uB0B4 \uC55E\uC5D0 \uB0B4\uB824\uB193\uACE0, \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC0AC\uD0D5 \uD558\uB098\uB97C \uAEBC\uB0B4 \uC606\uC5D0 \uB450\uC5C8\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC8FC\uB9D0\uC5D4 \uAF2D \uBB54\uAC00 \uBAB0\uB824\uC640. \uADF8 \uC804\uAE4C\uC9C0 \uB9C8\uC744 \uC704\uD5D8\uB3C4\uB97C \uB0AE\uCDB0 \uB46C. \u2026\uC790, \uCCAB\uB0A0 \uBC24\uC774\uB2E4."
  raidIntro:
  - speaker: 
    text: "\uC8FC\uB9D0 \uBC24. \uBD81\uCABD \uC232\uC5D0\uC11C \uAE38\uAC8C \uC774\uC5B4\uC9C0\uB294 \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB9C8\uC744\uC744 \uB36E\uC5C8\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC654\uB2E4. \uB291\uB300 \uBB34\uB9AC\uC57C. \uC774\uBC88 \uC8FC\uC5D0 \uB124\uAC00 \uAC78\uB7EC \uB0B8 \uC758\uB8B0\uB4E4\uC774\u2026 \uC9C0\uAE08 \uACB0\uACFC\uB85C \uB3CC\uC544\uC628\uB2E4."
  - speaker: 
    text: "\uB9C8\uC744 \uC704\uD5D8\uB3C4\uAC00 \uACE7 \uC2B5\uACA9\uC758 \uADDC\uBAA8\uB2E4. \uC26C\uACE0 \uC788\uB358 \uBAA8\uD5D8\uAC00\uB4E4\uC774 \uBC29\uCC45\uC73C\uB85C \uBAA8\uC5EC\uB4E0\uB2E4."
  raidPerfect:
  - speaker: 
    text: "\uBD81\uBB38\uC5D0 \uBD88\uC774 \uBC1D\uD600\uC9C0\uC790 \uAC00\uC7A5 \uBA3C\uC800 \uB2EC\uB824 \uB098\uC628 \uC774\uB984\uB4E4 \u2014 {defenders}."
  - speaker: '{hero}'
    text: "\uC811\uC218\uC6D0! \uC5EC\uAE30\uB294 \uC6B0\uB9AC\uAC00 \uB9E1\uC744\uAC8C. \uC548\uC5D0 \uC788\uC5B4!"
  - speaker: 
    text: "\uC0C8\uBCBD\uC774 \uC624\uAE30 \uC804\uC5D0 \uB291\uB300\uB4E4\uC740 \uC232\uC73C\uB85C \uBB3C\uB7EC\uB0AC\uB2E4. \uBD80\uC0C1\uC790 \uC5C6\uC74C."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\uC798\uD588\uC5B4. \uB124\uAC00 \uBCF4\uB0B8 \uC758\uB8B0\uB4E4\uC774, \uB124\uAC00 \uB9C9\uC544 \uB0B8 \uC0AC\uACE0\uB4E4\uC774 \uC624\uB298 \uB9C8\uC744\uC744 \uC9C0\uCF30\uC5B4."
  raidClose:
  - speaker: 
    text: "\uB3D9\uBB38\uC774 \uB6AB\uB9B4 \uBED4\uD588\uB2E4. \uC9C0\uCE5C \uBAA8\uD5D8\uAC00\uB4E4\uC774 \uBA87 \uBC88\uC774\uACE0 \uB2E4\uC2DC \uC77C\uC5B4\uC130\uB2E4."
  - speaker: '{hero}'
    text: "\uD558\uC544, \uD558\uC544\u2026 \uAC04\uC2E0\uD788\u2026 \uB9C9\uC558\uC5B4. \uB2E4\uC74C \uC8FC\uC5D4\u2026 \uC880 \uB354 \uBD80\uD0C1\uD574, \uC811\uC218\uC6D0."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uBC84\uD17C\uB2E4. \uADF8\uAC78\uB85C \uB410\uC5B4. \u2026\uD558\uC9C0\uB9CC \uC704\uD5D8\uB3C4\uAC00 \uC774\uB807\uAC8C \uB192\uC73C\uBA74 \uB2E4\uC74C\uC5D4 \uC7A5\uB2F4 \uBABB \uD574."
  raidFail:
  - speaker: 
    text: "\uBC29\uCC45\uC774 \uBB34\uB108\uC84C\uB2E4. \uBE44\uBA85\uACFC \uB291\uB300 \uC6B8\uC74C\uC774 \uB4A4\uC11E\uC600\uB2E4."
  - speaker: 
    text: "\uADF8\uB54C, \uAE38\uB4DC 2\uCE35 \uBB38\uC774 \uC5F4\uB9AC\uACE0 \uC740\uD1F4\uD55C \uAE38\uB4DC\uC7A5\uC774 \uB0A1\uC740 \uB300\uAC80\uC744 \uB4E4\uACE0 \uB0B4\uB824\uC654\uB2E4."
  - speaker: "\uADF8\uB77C\uD568"
    text: "\u2026\uC624\uB79C\uB9CC\uC774\uAD70. \uBB3C\uB7EC\uC11C\uB77C, \uC560\uC1A1\uC774\uB4E4."
  - speaker: 
    text: "\uB291\uB300\uB4E4\uC740 \uBB3C\uB7EC\uB0AC\uC9C0\uB9CC \uAE38\uB4DC\uB294 \uD070 \uBE5A\uC744 \uC84C\uB2E4. \uADF8\uB77C\uD568\uC740 \uB450 \uBC88 \uB098\uC11C \uC8FC\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\uB2E4\uC74C \uC2B5\uACA9\uC5D0\uC11C \uB610 \uBB34\uB108\uC9C0\uBA74, \uC774 \uB9C8\uC744\uC740 \uB05D\uC774\uC57C."
  proofIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
