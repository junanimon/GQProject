    portrait: {fileID: 3937434761614297692, guid: 6b9a50d1b57616b47bedc9bef055f231, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  - label: "\uD54D"
    body: {fileID: 6080790682506497737, guid: ff02003c818afae49b7750d070553e48, type: 3}
    portrait: {fileID: 7620592035548990562, guid: c489e60dbd0c4ed4ab676e5549fce05f, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  urgentMessenger: "\uC804\uB839"
  intro:
  - speaker: 
    text: "\uBCC0\uACBD\uC758 \uC791\uC740 \uB9C8\uC744, \uB85C\uC6F0. \uBAA8\uD5D8\uAC00\uB4E4\uC758 \uCCAB \uBC1C\uAC78\uC74C\uC774 \uC2DC\uC791\uB418\uB294 \uACF3."
  - speaker: 
    text: "\uC624\uB298\uBD80\uD130 \uB098\uB294 \uC774\uACF3 \uBAA8\uD5D8\uAC00 \uAE38\uB4DC\uC758 \uC2E0\uC785 \uC811\uC218\uC6D0\uC774\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uB124\uAC00 \uC2E0\uC785\uC774\uAD6C\uB098. \uB9C8\uB974\uD0C0\uB2E4. \uC5EC\uAE30 \uC811\uC218 \uB2F4\uB2F9\uC774\uACE0, \uC624\uB298\uBD80\uD130 \uB124 \uC120\uBC30."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC77C\uC740 \uB450 \uAC00\uC9C0\uC57C. \uBC24\uC5D0\uB294 \uC758\uB8B0\uC778\uB4E4\uC774 \uB450\uACE0 \uAC04 \uC758\uB8B0\uC11C\uB97C \uC77D\uACE0 '\uAE38\uB4DC \uAE30\uC785\uB780'\uC744 \uCC44\uC6CC. \uBB34\uC2A8 \uBAAC\uC2A4\uD130\uC778\uC9C0, \uBA87 \uB9C8\uB9AC\uC778\uC9C0. \uB3C4\uAC10 \uBCF4\uACE0 \uB4F1\uAE09\uC774\uB791 \uC5ED\uD560 \uB3C4\uC7A5\uAE4C\uC9C0."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uB0AE\uC5D0\uB294 \uCC3D\uAD6C. \uBAA8\uD5D8\uAC00 \uCE74\uB4DC\uB791 \uC758\uB8B0\uC11C\uB97C \uBCF4\uACE0 \uADDC\uC815\uB300\uB85C \uC2B9\uC778\uD558\uAC70\uB098 \uAC70\uC808\uD574. \uC77C\uC744 \uB9C8\uCE58\uACE0 \uC628 \uB140\uC11D\uB4E4\uC740 \uC99D\uAC70\uBB3C\uC774 \uAC8C\uC2DC\uBCF8\uC774\uB791 \uB9DE\uB294\uC9C0 \uBCF4\uACE0."
  - speaker: "\uB098"
    text: "\uAE30\uC900\uC740\u2026 \uC81C\uAC00 \uBC24\uC5D0 \uC4F4 \uAE30\uC785\uB780\uC778\uAC00\uC694?"
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uADF8\uB798. \uBC24\uC5D0 \uB300\uCDA9 \uC4F0\uBA74 \uB0AE\uC5D0 \uC544\uBB34\uB9AC \uC798\uD574\uB3C4 \uC18C\uC6A9\uC5C6\uC5B4. \uC758\uB8B0\uC778 \uB9D0\uC740 \uBC18\uB9CC \uBBFF\uC5B4. \uD638\uB4E4\uAC11 \uB5A0\uB294 \uC0AC\uB78C\uB3C4, '\uBCC4\uC77C \uC544\uB2C8\uC624' \uD558\uB294 \uC0AC\uB78C\uB3C4 \uC788\uC73C\uB2C8\uAE4C."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\uADF8\uB9AC\uACE0 \uD2C0\uB9AC\uBA74, \uB300\uAC00\uB294 \uB124\uAC00 \uC544\uB2C8\uB77C \uBAA8\uD5D8\uAC00\uB4E4\uC774 \uCE58\uB7EC. \uBA85\uC2EC\uD574."
  - speaker: 
    text: "\uC120\uBC30\uB294 \uC11C\uB958 \uBB49\uCE58\uB97C \uB0B4 \uC55E\uC5D0 \uB0B4\uB824\uB193\uACE0, \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC0AC\uD0D5 \uD558\uB098\uB97C \uAEBC\uB0B4 \uC606\uC5D0 \uB450\uC5C8\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC8FC\uB9D0\uC5D4 \uAF2D \uBB54\uAC00 \uBAB0\uB824\uC640. \uADF8 \uC804\uAE4C\uC9C0 \uB9C8\uC744 \uC704\uD5D8\uB3C4\uB97C \uB0AE\uCDB0 \uB46C. \u2026\uC790, \uCCAB\uB0A0 \uBC24\uC774\uB2E4."
  memorial:
  - speaker: 
    text: "\uCC3D\uAD6C \uC606 \uAC8C\uC2DC\uD310\uC5D0 \uC0C8 \uCABD\uC9C0\uAC00 \uD55C \uC7A5 \uBD99\uC5C8\uB2E4. '{name} \u2014 \uADC0\uD658\uD558\uC9C0 \uBABB\uD568'."
  - speaker: 
    text: "\uB298 {name}\uC774(\uAC00) \uC11C \uC788\uB358 \uC790\uB9AC\uAC00, \uC624\uB298\uB530\uB77C \uC720\uB09C\uD788 \uB113\uC5B4 \uBCF4\uC778\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\u2026\uC6B0\uB9AC\uAC00 \uC4F4 \uC11C\uB958 \uD55C \uC7A5\uC774 \uB204\uAD70\uAC00\uC758 \uB9C8\uC9C0\uB9C9 \uC758\uB8B0\uC11C\uAC00 \uB420 \uC218\uB3C4 \uC788\uC5B4. \uC78A\uC9C0 \uB9C8."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC624\uB298 \uBC24 \uC11C\uB958\uB294 \uCC9C\uCC9C\uD788 \uC368. \uAE09\uD560 \uAC70 \uC5C6\uC5B4."
  endingGood:
  - speaker: 
    text: "\uC232\uC758 \uC655\uC774 \uC4F0\uB7EC\uC9C4 \uC790\uB9AC\uC5D0\uC11C, \uC740\uBE5B \uC5EC\uC6B0\uB4E4\uC758 \uB178\uB798\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
  - speaker: 
    text: "\uBD09\uC778\uC740 \uB2E4\uC2DC \uB2EB\uD614\uB2E4. \uB85C\uC6F0\uC758 \uBC29\uCC45 \uC704\uB85C \uCCAB \uD587\uC0B4\uC774 \uBE44\uCCE4\uB2E4."
  - speaker: '{hero}'
    text: "\uC811\uC218\uC6D0! \uC6B0\uB9AC\uAC00 \uD574\uB0C8\uC5B4! \u2026\uB124\uAC00 \uC368 \uC900 \uC11C\uB958 \uB355\uBD84\uC774\uC57C."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC2E0\uC785. \uC544\uB2C8, \uC774\uC81C \uC2E0\uC785\uC774\uB77C\uACE0 \uBD80\uB974\uBA74 \uC548 \uB418\uACA0\uB124."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uB0B4\uC77C\uB3C4 \uCC3D\uAD6C\uB294 \uC5F4\uB824. \uBAA8\uD5D8\uAC00\uB4E4\uC740 \uB610 \uC62C \uAC70\uACE0, \uC758\uB8B0\uC11C\uB3C4 \uB610 \uC313\uC774\uACA0\uC9C0. \u2026\uAC19\uC774 \uD558\uC790."
  endingBitter:
  - speaker: 
    text: "\uC232\uC758 \uC655\uC740 \uBB3C\uB7EC\uB0AC\uB2E4. \uD558\uC9C0\uB9CC \uC644\uC804\uD788 \uC7A0\uB4E4\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - speaker: 
    text: "\uBB34\uB108\uC9C4 \uBC29\uCC45\uC744 \uACE0\uCE58\uB294 \uB9DD\uCE58 \uC18C\uB9AC\uAC00 \uBA70\uCE60 \uB3D9\uC548 \uC774\uC5B4\uC84C\uB2E4."
  - speaker: '{hero}'
    text: "\u2026\uB2E4\uC74C\uC5D4, \uB354 \uC798\uD560 \uC218 \uC788\uC744 \uAC70\uC57C. \uADF8\uB807\uC9C0, \uC811\uC218\uC6D0?"
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC0B4\uC544\uB0A8\uC740 \uAC8C \uC774\uAE34 \uAC70\uC57C. \uC624\uB298\uC740 \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574."
  endings:
  - id: good
    title: "\uAD7F \uC5D4\uB529 \u2014 \uC232\uC774 \uC7A0\uB4E0 \uC544\uCE68"
    kind: 0
    week: 0
    lines:
    - speaker: 
      text: "\uC232\uC758 \uC655\uC774 \uC4F0\uB7EC\uC9C4 \uC790\uB9AC\uC5D0\uC11C, \uC740\uBE5B \uC5EC\uC6B0\uB4E4\uC758 \uB178\uB798\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
    - speaker: 
      text: "\uBD09\uC778\uC740 \uB2E4\uC2DC \uB2EB\uD614\uB2E4. \uB85C\uC6F0\uC758 \uBC29\uCC45 \uC704\uB85C \uCCAB \uD587\uC0B4\uC774 \uBE44\uCCE4\uB2E4."
    - speaker: '{hero}'
      text: "\uC811\uC218\uC6D0! \uC6B0\uB9AC\uAC00 \uD574\uB0C8\uC5B4! \u2026\uB124\uAC00 \uC368 \uC900 \uC11C\uB958 \uB355\uBD84\uC774\uC57C."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC2E0\uC785. \uC544\uB2C8, \uC774\uC81C \uC2E0\uC785\uC774\uB77C\uACE0 \uBD80\uB974\uBA74 \uC548 \uB418\uACA0\uB124."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uB0B4\uC77C\uB3C4 \uCC3D\uAD6C\uB294 \uC5F4\uB824. \uBAA8\uD5D8\uAC00\uB4E4\uC740 \uB610 \uC62C \uAC70\uACE0, \uC758\uB8B0\uC11C\uB3C4 \uB610 \uC313\uC774\uACA0\uC9C0. \u2026\uAC19\uC774 \uD558\uC790."
  - id: bitter
    title: "\uC501\uC4F8\uD55C \uC5D4\uB529 \u2014 \uACA8\uC6B0 \uC9C0\uD0A8 \uB9C8\uC744"
    kind: 1
    week: 0
    lines:
    - speaker: 
      text: "\uC232\uC758 \uC655\uC740 \uBB3C\uB7EC\uB0AC\uB2E4. \uD558\uC9C0\uB9CC \uC644\uC804\uD788 \uC7A0\uB4E4\uC9C0\uB294 \uC54A\uC558\uB2E4."
    - speaker: 
      text: "\uBB34\uB108\uC9C4 \uBC29\uCC45\uC744 \uACE0\uCE58\uB294 \uB9DD\uCE58 \uC18C\uB9AC\uAC00 \uBA70\uCE60 \uB3D9\uC548 \uC774\uC5B4\uC84C\uB2E4."
    - speaker: '{hero}'
      text: "\u2026\uB2E4\uC74C\uC5D4, \uB354 \uC798\uD560 \uC218 \uC788\uC744 \uAC70\uC57C. \uADF8\uB807\uC9C0, \uC811\uC218\uC6D0?"
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC0B4\uC544\uB0A8\uC740 \uAC8C \uC774\uAE34 \uAC70\uC57C. \uC624\uB298\uC740 \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574."
  - id: bad_w2
    title: "\uBC30\uB4DC \uC5D4\uB529 \u2014 \uBE48 \uCD95\uC81C \uAD11\uC7A5"
    kind: 2
    week: 2
    lines:
    - speaker: 
      text: "\uCD95\uC81C \uB4F1\uBD88\uC774 \uCC44 \uAEBC\uC9C0\uAE30\uB3C4 \uC804\uC5D0, \uBC29\uCC45\uC774 \uBB34\uB108\uC84C\uB2E4."
    - speaker: 
      text: "\uC678\uBD80 \uAE38\uB4DC \uC190\uB2D8\uB4E4\uC740 \uC9D0\uC744 \uC2F8\uC11C \uB5A0\uB0AC\uACE0, \uAD11\uC7A5\uC5D0\uB294 \uCC22\uC5B4\uC9C4 \uAE43\uBC1C\uB9CC \uB0A8\uC558\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\uAE38\uB4DC \uBCF8\uBD80\uC5D0\uC11C \uACF5\uBB38\uC774 \uC654\uC5B4. \uB85C\uC6F0 \uC9C0\uBD80\uB294 \uB2F9\uBD84\uAC04 \uBB38\uC744 \uB2EB\uB294\uB300."
    - speaker: '{hero}'
      text: "\uC811\uC218\uC6D0 \uD0D3 \uC544\uB2C8\uC5D0\uC694. \u2026\uC544\uB2C8, \uADF8\uB7F0 \uB9D0 \uD574\uB3C4 \uC18C\uC6A9\uC5C6\uACA0\uC8E0."
    - speaker: 
      text: "\uC9D0\uC744 \uC2F8\uB294 \uC190\uC774 \uB5A8\uB838\uB2E4. \uAC8C\uC2DC\uD310\uC5D0\uB294 \uC544\uBB34\uB3C4 \uB5BC\uC5B4 \uAC00\uC9C0 \uC54A\uC740 \uC758\uB8B0\uC11C\uAC00 \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB838\uB2E4."
  - id: bad_w3
    title: "\uBC30\uB4DC \uC5D4\uB529 \u2014 \uC218\uBC30\uC11C\uB9CC \uB0A8\uC740 \uAC8C\uC2DC\uD310"
    kind: 2
    week: 3
    lines:
    - speaker: 
      text: "\uC2B5\uACA9\uC774 \uC9C0\uB098\uAC04 \uB4A4, \uB9C8\uC744 \uBC14\uAE65\uC740 \uB3C4\uC801\uACFC \uBAAC\uC2A4\uD130\uC758 \uB545\uC774 \uB418\uC5C8\uB2E4."
    - speaker: 
      text: "\uAC8C\uC2DC\uD310\uC5D0\uB294 \uC758\uB8B0\uC11C \uB300\uC2E0 \uC218\uBC30\uC11C\uB9CC \uB298\uC5B4 \uAC14\uB2E4. \uBC1B\uC544 \uAC08 \uBAA8\uD5D8\uAC00\uAC00 \uC5C6\uC5C8\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uBAA8\uD5D8\uAC00\uAC00 \uC5C6\uB294 \uAE38\uB4DC\uB294 \uADF8\uB0E5 \uC885\uC774 \uCC3D\uACE0\uC57C. \u2026\uBCF8\uBD80\uAC00 \uC778\uAC00\uB97C \uAC70\uB46C \uAC14\uC5B4."
    - speaker: '{hero}'
      text: "\u2026\uB2E4\uB978 \uB9C8\uC744\uB85C \uAC00\uC694. \uAC70\uAE30\uC11C\uB3C4 \uB2F9\uC2E0 \uCC3D\uAD6C\uC5D0 \uC904 \uC124\uAC8C\uC694."
    - speaker: 
      text: "\uB85C\uC6F0 \uBAA8\uD5D8\uAC00 \uAE38\uB4DC\uC758 \uAC04\uD310\uC774 \uB0B4\uB824\uC84C\uB2E4."
  - id: bad_w4
    title: "\uBC30\uB4DC \uC5D4\uB529 \u2014 \uBB38 \uB2EB\uC740 \uCC3D\uAD6C"
    kind: 2
    week: 4
    lines:
    - speaker: 
      text: "\uBCD1\uACFC \uC2B5\uACA9\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uB36E\uCCE4\uB2E4. \uC601\uC8FC\uB294 \uB9C8\uC744 \uC804\uCCB4\uB97C \uBD09\uC1C4\uD558\uACE0 \uD53C\uB09C\uB839\uC744 \uB0B4\uB838\uB2E4."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uB05D\uAE4C\uC9C0 \uB0A8\uACA0\uB2E4\uACE0 \uD588\uB294\uB370\u2026 \uC774\uBC88\uC5D4 \uC81C \uC190\uC73C\uB85C\uB3C4 \uBD80\uC871\uD588\uC5B4\uC694."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC0B4\uC544\uC11C \uB098\uAC00\uB294 \uAC8C \uBA3C\uC800\uC57C. \uC11C\uB958\uB294 \uB450\uACE0 \uAC00."
    - speaker: 
      text: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uCC3D\uAD6C \uB367\uBB38\uC744 \uB0B4\uB838\uB2E4. \uC548\uCABD\uC5D0 \uBD99\uC5EC \uB454 '\uC624\uB298\uB3C4 \uBB34\uC0AC \uADC0\uD658' \uCABD\uC9C0\uAC00 \uBCF4\uC600\uB2E4."
  - id: bad_w5
    title: "\uBC30\uB4DC \uC5D4\uB529 \u2014 \uC232\uC774 \uC0BC\uD0A8 \uB9C8\uC744"
    kind: 2
    week: 5
    lines:
    - speaker: 
      text: "\uC232\uC758 \uC655\uC774 \uAE68\uC5B4\uB0AC\uB2E4. \uBD09\uC778\uC740 \uBC84\uD2F0\uC9C0 \uBABB\uD588\uB2E4."
    - speaker: 
      text: "\uB098\uBB34\uBFCC\uB9AC\uAC00 \uBC29\uCC45\uC744 \uB6AB\uACE0, \uC548\uAC1C\uAC00 \uAD11\uC7A5\uC744 \uC0BC\uCF30\uB2E4. \uBAA8\uD5D8\uAC00\uB4E4\uC740 \uB05D\uAE4C\uC9C0 \uC2F8\uC6E0\uB2E4."
    - speaker: '{hero}'
      text: "\uB3C4\uB9DD\uCCD0\uC694! \uB2F9\uC2E0\uB9CC\uC740\u2026 \uAE30\uB85D\uC744 \uB0A8\uACA8\uC57C \uD558\uC796\uC544\uC694!"
    - speaker: 
      text: "\uD488\uC5D0 \uC548\uC740 \uC7A5\uBD80 \uD55C \uAD8C\uB9CC \uB4E4\uACE0 \uC5B8\uB355\uC744 \uB118\uC5C8\uB2E4. \uB4A4\uB3CC\uC544\uBCF8 \uB85C\uC6F0\uC740 \uC774\uBBF8 \uC232\uC774\uC5C8\uB2E4."
    - speaker: 
      text: "\uADF8 \uC7A5\uBD80\uC5D0\uB294 \uB2E4\uC12F \uC8FC \uB3D9\uC548 \uCC3D\uAD6C\uB97C \uC9C0\uB098\uAC04 \uBAA8\uB4E0 \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
  randomEvents:
  - title: "\uD55C\uB098\uC758 \uAFC0\uBE75"
    minWeek: 1
    maxWeek: 5
    chance: 0.3
    effect: 4
    amount: 3
    lines:
    - speaker: "\uD55C\uB098"
      text: "\uC811\uC218\uC6D0 \uC544\uAC00\uC528! \uC624\uB298 \uBE75\uC774 \uB108\uBB34 \uB9CE\uC774 \uAD6C\uC6CC\uC838\uC11C\uC694. \uBAA8\uD5D8\uAC00\uB4E4 \uC880 \uB098\uB220 \uC918\uC694~"
    - speaker: 
      text: "\uD640\uC5D0 \uAFC0\uBE75 \uB0C4\uC0C8\uAC00 \uD37C\uC84C\uB2E4. \uB2C8\uC544\uC758 \uADC0\uAC00 \uCAD1\uAE0B \uC130\uB2E4."
    - speaker: "\uB8E8\uB8E8"
      text: "\uACF5\uC9DC\uC57C? \uC9C4\uC9DC \uACF5\uC9DC? \u2026\uB300\uB9C8\uBC95\uC0AC\uB294 \uC0AC\uC591\uD558\uC9C0 \uC54A\uC544!"
  - title: "\uBE44 \uC0C8\uB294 \uC9C0\uBD95"
    minWeek: 1
    maxWeek: 5
    chance: 0.25
    effect: 1
    amount: -30
    lines:
    - speaker: 
      text: "\uBC24\uC0C8 \uBE44\uAC00 \uB0B4\uB838\uB2E4. \uC544\uCE68\uC5D0 \uBCF4\uB2C8 \uAE30\uB85D\uC2E4 \uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uB69D\uB69D \uB5A8\uC5B4\uC9C4\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC11C\uB958 \uC816\uAE30 \uC804\uC5D0 \uACE0\uCCD0\uC57C\uC9C0 \uBB50. \u2026\uC218\uB9AC\uBE44\uB294 \uAE38\uB4DC \uC790\uAE08\uC5D0\uC11C \uB098\uAC08 \uAC70\uC57C."
  - title: "\uACE0\uC591\uC774 \uC0AC\uBB34\uC6D0"
    minWeek: 1
    maxWeek: 3
    chance: 0.3
    effect: 4
    amount: 2
    lines:
    - speaker: 
      text: "\uCC3D\uAD6C \uC704\uC5D0 \uB204\uB7F0 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uAC00 \uC758\uB8B0\uC11C\uB97C \uAE54\uACE0 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC640, \uADC0\uC5FD\uB2E4! \uC120\uBC30, \uC774 \uB140\uC11D \uAE38\uB4DC\uC5D0\uC11C \uD0A4\uC6B0\uBA74 \uC548 \uB3FC\uC694?"
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC950\uB9CC \uC798 \uC7A1\uC73C\uBA74 \uBA85\uC608 \uC0AC\uBB34\uC6D0\uC73C\uB85C \uC784\uBA85\uD574 \uC8FC\uC9C0."
  - title: "\uC220\uC9D1 \uC2F8\uC6C0"
    minWeek: 1
    maxWeek: 4
    chance: 0.25
    effect: 3
    amount: -3
    lines:
    - speaker: 
      text: "\uBC24\uB2A6\uAC8C '\uC878\uB9B0 \uC5EC\uC6B0' \uC220\uC9D1\uC5D0\uC11C \uBAA8\uD5D8\uAC00\uB4E4 \uC0AC\uC774\uC5D0 \uC8FC\uBA39\uB2E4\uC9D0\uC774 \uBC8C\uC5B4\uC84C\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\uACBD\uBE44\uB300\uC7A5\uC774 \uC544\uCE68\uC5D0 \uD55C\uB9C8\uB514 \uD558\uB7EC \uC624\uACA0\uB124. \uAE38\uB4DC \uC5BC\uAD74\uC5D0 \uBA39\uCE60\uC774\uC57C."
  - title: "\uC775\uBA85\uC758 \uAE30\uBD80"
    minWeek: 2
    maxWeek: 5
    chance: 0.2
    effect: 1
    amount: 60
    lines:
    - speaker: 
      text: "\uCC3D\uAD6C \uBB38\uD2C8\uC5D0 \uBB35\uC9C1\uD55C \uC8FC\uBA38\uB2C8\uAC00 \uB07C\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uCABD\uC9C0 \uD55C \uC7A5: '\uB298 \uC218\uACE0\uAC00 \uB9CE\uC18C.'"
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uB204\uAD70\uC9C0 \uB300\uCDA9 \uC9D0\uC791\uC740 \uAC00\uB294\uB370\u2026 \uBAA8\uB978 \uCC99\uD574 \uC8FC\uC790."
  - title: "\uC74C\uC720\uC2DC\uC778\uC758 \uB178\uB798"
    minWeek: 2
    maxWeek: 5
    chance: 0.25
    effect: 3
    amount: 4
    lines:
    - speaker: 
      text: "\uB5A0\uB3CC\uC774 \uC74C\uC720\uC2DC\uC778\uC774 \uAD11\uC7A5\uC5D0\uC11C '\uB85C\uC6F0 \uAE38\uB4DC\uC758 \uAF3C\uAF3C\uD55C \uC811\uC218\uC6D0' \uB178\uB798\uB97C \uBD88\uB800\uB2E4."
    - speaker: "\uB808\uC628"
      text: "\uD760, \uAC00\uC0AC\uC5D0 \uB0B4 \uC774\uB984\uC774 \uBE60\uC84C\uAD70. 2\uC808\uC5D0 \uB4E4\uC5B4\uAC00\uACA0\uC9C0?"
  - title: "\uACBD\uBE44\uB300 \uC21C\uCC30 \uAC15\uD654"
    minWeek: 2
    maxWeek: 5
    chance: 0.25
    effect: 2
    amount: -8
    lines:
    - speaker: 
      text: "\uC601\uC8FC\uC758 \uBA85\uC73C\uB85C \uACBD\uBE44\uB300\uAC00 \uBC24 \uC21C\uCC30\uC744 \uB450 \uBC30\uB85C \uB298\uB838\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uB2F9\uBD84\uAC04\uC740 \uB9C8\uC744 \uBC14\uAE65\uC774 \uC880 \uC870\uC6A9\uD558\uACA0\uB124."
  - title: "\uBC24\uC911\uC758 \uC6B8\uC74C\uC18C\uB9AC"
    minWeek: 3
    maxWeek: 5
    chance: 0.3
    effect: 2
    amount: 6
    lines:
    - speaker: 
      text: "\uC790\uC815 \uBB34\uB835, \uBD81\uCABD \uC232\uC5D0\uC11C \uAE38\uACE0 \uB0AE\uC740 \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uAC1C\uB4E4\uC774 \uC77C\uC81C\uD788 \uC9D6\uC5C8\uB2E4."
    - speaker: "\uB2C8\uC544"
      text: "\u2026\uB098\uBB34\uAC00 \uC6B8\uC5B4. \uC810\uC810 \uAC00\uAE4C\uC6CC\uC838."
  - title: "\uC601\uC8FC\uC758 \uC2DC\uCC30 \uC608\uACE0"
    minWeek: 4
    maxWeek: 5
    chance: 0.3
    effect: 3
    amount: 3
    lines:
    - speaker: 
      text: "\uC601\uC8FC\uAC00 \uB2E4\uC74C \uB2EC \uAE38\uB4DC\uB97C \uC2DC\uCC30\uD558\uACA0\uB2E4\uB294 \uC804\uAC08\uC774 \uC654\uB2E4. \uAE30\uB85D\uC2E4\uC744 \uB300\uCCAD\uC18C\uD588\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC11C\uB958 \uC815\uB9AC \uC0C1\uD0DC\uB294 \uB124 \uB355\uC5D0 \uBB38\uC81C\uC5C6\uACA0\uC5B4. \uCE6D\uCC2C\uC774\uC57C."
  facilities:
  - kind: 0
    name: "\uB3CB\uBCF4\uAE30"
    description: "\uC11C\uB958\uB97C \uBE68\uB9AC \uD6D1\uC744 \uC218 \uC788\uB2E4. \uB0AE \uC601\uC5C5 \uC2DC\uAC04 +20\uCD08."
    price: 120
    unlockWeek: 1
    maxCount: 1
    weekly: 0
  - kind: 4
    name: "\uBAA8\uC9D1 \uC804\uB2E8"
    description: "\uB9C8\uC744 \uACF3\uACF3\uC5D0 \uBD99\uC774\uB294 \uC804\uB2E8. \uC774\uBC88 \uC8FC \uC8FC\uAC04 \uC815\uC0B0 \uB54C \uC2E0\uADDC \uBAA8\uD5D8\uAC00 +2, \uD3C9\uD310 +2. (\uB9E4\uC8FC \uB2E4\uC2DC \uC0AC\uC57C \uD55C\uB2E4)"
    price: 40
    unlockWeek: 1
    maxCount: 1
    weekly: 1
  - kind: 1
    name: "\uC99D\uAC70\uBB3C \uC800\uC6B8"
    description: "\uADC0\uD658 \uBCF4\uACE0\uC758 \uC99D\uAC70\uBB3C\uC744 \uB2EC\uC544 \uBCF8\uB2E4. \uAC8C\uC2DC\uBCF8 \uAE30\uC785\uACFC \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uBCF4\uACE0\uC11C\uC5D0 [\uC800\uC6B8] \uD45C\uC2DC\uAC00 \uB72C\uB2E4."
    price: 180
    unlockWeek: 2
    maxCount: 1
    weekly: 0
  - kind: 3
    name: "\uD734\uAC8C\uC2E4"
    description: "\uD640 \uAD6C\uC11D\uC5D0 \uC18C\uD30C\uC640 \uB09C\uB85C. \uBD80\uC0C1 \uD68C\uBCF5\uC774 \uB450 \uBC30, \uC7A1\uB2F4\uC73C\uB85C \uC624\uB974\uB294 \uD638\uAC10\uB3C4\uB3C4 \uB450 \uBC30."
    price: 150
    unlockWeek: 2
    maxCount: 1
    weekly: 0
  promotionLevel: 060000000c000000i
  promotionRecord: 0300000006000000i
