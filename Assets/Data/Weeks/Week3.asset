  m_Script: {fileID: 11500000, guid: 7fca7b8a76b4a0d4cb38af2b9837f4d1, type: 3}
  m_Name: Week3
  m_EditorClassIdentifier: Assembly-CSharp::GuildProto.WeekData
  title: "\uC804\uD658\uC810"
  subtitle: "\uC218\uBC30 \uC8FC\uAC04 \u2014 \uC774\uBC88 \uC8FC\uBD80\uD130 \uBAA8\uD5D8\uAC00\uAC00 \uC8FD\uC744 \uC218 \uC788\uB2E4"
  tempRule: 2
  unlocks:
  - day: 1
    unlock: 2
  - day: 1
    unlock: 4
  sheetsPerNight: 4
  monsterPool:
  - {fileID: 11400000, guid: 3eb761193cde77f4da8e5d84bb56993e, type: 2}
  - {fileID: 11400000, guid: f863aa1a1ba52d945b3cff42dcf394f8, type: 2}
  - {fileID: 11400000, guid: 13a4eb1787e2f1442a4ab3e03d8f67c7, type: 2}
  - {fileID: 11400000, guid: 1696f636d6bebd54a9a5d6d2bf723f44, type: 2}
  - {fileID: 11400000, guid: a776734c79a90584d9d4fa479d4e1d35, type: 2}
  - {fileID: 11400000, guid: 67e9e4a3bc88d5b409f4b34f21dd0c86, type: 2}
  - {fileID: 11400000, guid: f2ec47cd7faba3a41af5662e671a77b3, type: 2}
  - {fileID: 11400000, guid: 2c57599265534884b9ff1aaf1fb552ad, type: 2}
  - {fileID: 11400000, guid: 3f2efb3fc899061489e20b66993e14dd, type: 2}
  errandChance: 0.15
  fixedQuests: []
  intro:
  - speaker: 
    text: "\uCD95\uC81C\uAC00 \uB05D\uB098\uC790 \uB9C8\uC744 \uAC8C\uC2DC\uD310\uC5D0 \uC218\uBC30\uC11C \uC138 \uC7A5\uC774 \uBD99\uC5C8\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "'\uAC80\uC740 \uC950' \uB3C4\uC801\uB2E8\uC774\uC57C. \uCD95\uC81C \uD2C8\uC5D0 \uB4E4\uC5B4\uC640\uC11C \uC544\uC9C1 \uB9C8\uC744\uC5D0 \uC228\uC5B4 \uC788\uC5B4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uBAA8\uD5D8\uAC00 \uD589\uC138\uB97C \uD558\uACE0 \uCC3D\uAD6C\uC5D0 \uC62C \uC218\uB3C4 \uC788\uC5B4. \uC218\uBC30\uC11C\uB791 \uC5BC\uAD74, \uC774\uB984, \uAC00\uBA85\uC744 \uB300\uC870\uD574. \uB9DE\uC73C\uBA74 \uBC1B\uC9C0 \uB9D0\uACE0 \uC2E0\uACE0 \uC885\uC744 \uC6B8\uB824."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC774\uBC88 \uC8FC\uBD80\uD130\uB294 \uCE74\uB4DC \uCD08\uC0C1\uD654\uB3C4 \uCC3D\uAD6C\uC5D0 \uC120 \uBCF8\uC778\uACFC \uB300\uC870\uD574. \uB0A8\uC758 \uCE74\uB4DC\uB85C \uC624\uB294 \uB188\uB4E4\uC774 \uC788\uC5B4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\u2026\u2026\uADF8\uB9AC\uACE0 \uD558\uB098 \uB354. \uC9C0\uAE08\uBD80\uD130\uB294 \uBB34\uB9AC\uD55C \uC758\uB8B0\uC5D0 \uB098\uAC04 \uBAA8\uD5D8\uAC00\uAC00 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD560 \uC218 \uC788\uC5B4."
  - speaker: "\uB808\uC628"
    text: "(\uC218\uBC30\uC11C \uC55E\uC5D0\uC11C \uD55C\uCC38 \uC11C \uC788\uB2E4) \u2026\uD54D, \uC774 \uB140\uC11D\uC774\u2026"
  dayStories:
  - day: 2
    id: expedition_depart
    title: "\uC6D0\uC815 \uC804\uC57C"
    lines:
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAF2C\uB9C8. \uB0B4\uC77C \uC0C8\uBCBD\uC5D0 \uBD81\uCABD \uC232\uC5D0 \uB2E4\uB140\uC640\uC57C\uACA0\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC232\uC774 \uB108\uBB34 \uC2DC\uB044\uB7EC\uC6CC. \uB291\uB300\uC5D0 \uC624\uD06C\uC5D0 \uD2B8\uB864\uAE4C\uC9C0\u2026 \uBB54\uAC00\uAC00 \uAE68\uC5B4\uB098\uACE0 \uC788\uC5B4. \uC9C1\uC811 \uD655\uC778\uD574\uC57C \uD574."
    - speaker: "\uB098"
      text: "\uD63C\uC790\uC694? \uC6D0\uC815\uB300\uB97C \uAFB8\uB824\uC57C\uC8E0."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uD558\uD558! \uAC71\uC815\uB3C4 \uD314\uC790\uB2E4. \u2026\uADF8\uB798\uB3C4 \uD55C \uBA85\uCBE4\uC740 \uB370\uB824\uAC00 \uC8FC\uB9C8. \uB124\uAC00 \uACE8\uB77C\uB77C."
    - speaker: 
      text: "\uBC14\uB974\uD1A8\uC740 \uC0AC\uD0D5 \uB450 \uAC1C\uB97C \uCC3D\uAD6C\uC5D0 \uB450\uACE0 \uAC14\uB2E4. \"\uD558\uB098\uB294 \uB0B4\uC77C \uAC70\uB2E4.\""
  - day: 4
    id: expedition_alive
    title: "\uC6D0\uC815 \uADC0\uD658"
    lines:
    - speaker: 
      text: "\uC0C8\uBCBD. \uBD95\uB300\uD22C\uC131\uC774\uC758 \uBC14\uB974\uD1A8\uC774 {companion}\uC758 \uBD80\uCD95\uC744 \uBC1B\uC73C\uBA70 \uAE38\uB4DC \uBB38\uC744 \uC5F4\uC5C8\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uD558\uD558\u2026 \uB299\uC740 \uC0AC\uC790, \uC544\uC9C1 \uC548 \uC8FD\uC5C8\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\u2026\uBD24\uB2E4. \uC232 \uAE4A\uC740 \uACF3\uC5D0\uC11C, \uC2A4\uBB34 \uD574 \uC804\uC5D0 \uC7A0\uC7AC\uC6B4 \uADF8 \uB140\uC11D\uC774 \uB208\uC744 \uB728\uACE0 \uC788\uC5C8\uC5B4. '\uC232\uC758 \uC655'\uC774\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAF2C\uB9C8. \uC740\uD1F4\uB294 5\uC8FC \uB4A4\uB85C \uBBF8\uB8EC\uB2E4. \uC774\uBC88\uC5D4 \uB05D\uAE4C\uC9C0 \uAC19\uC774 \uC2F8\uC6B0\uC9C0."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\u2026\uB2E4\uD589\uC774\uC57C. \uC815\uB9D0\uB85C."
  - day: 4
    id: expedition_dead
    title: "\uB299\uC740 \uC0AC\uC790"
    lines:
    - speaker: 
      text: "\uC0C8\uBCBD. \uAE38\uB4DC \uBB38\uC744 \uC5F0 \uAC83\uC740 {companion} \uD63C\uC790\uC600\uB2E4. \uC544\uB2C8, \uC544\uBB34\uB3C4 \uC624\uC9C0 \uC54A\uC740 \uC0C8\uBCBD\uC774\uC5C8\uB2E4."
    - speaker: 
      text: "\uCC3D\uAD6C \uC704\uC5D0 \uB3C4\uB07C \uD55C \uC790\uB8E8\uAC00 \uB193\uC600\uB2E4. \uB0A0\uC5D0 \uBE44\uC6CC \uB450\uC5C8\uB358 \uC790\uB9AC\uC5D0, \uC0C8 \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4. \u2014 '\uC62C\uB9AC\uBC84'."
    - speaker: 
      text: "\uADF8\uB9AC\uACE0 \uC0AC\uD0D5 \uD55C \uAC1C."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\u2026\uBC14\uBCF4 \uAC19\uC740 \uC0AC\uB78C. \uB05D\uAE4C\uC9C0 \uD63C\uC790 \uC9CA\uC5B4\uC9C0\uACE0."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\u2026\uC544\uC800\uC528\uAC00, \uD615 \uC598\uAE30\u2026 \uB2E4 \uD574 \uC900\uB2E4\uACE0 \uD588\uB294\uB370."
    - speaker: "\uB8E8\uB8E8"
      text: "(\uB9D0\uC5C6\uC774 \uC9C0\uD321\uC774\uB97C \uAF49 \uC954\uB2E4)"
    - speaker: "\uB808\uC628"
      text: "\u2026\uC0AC\uC790 \uACBD\uC758 \uB3C4\uB07C\uB294, \uB0B4\uAC00 \uB4E4\uACA0\uB2E4. \uC774\uBC88\uC5D4 \uC774\uB984\uC744 \uAC78\uACE0."
    - speaker: 
      text: "\uADF8\uB0A0, \uBA87\uBA87 \uBAA8\uD5D8\uAC00\uC758 \uB208\uBE5B\uC774 \uB2EC\uB77C\uC84C\uB2E4."
  wanted:
  - name: "\uC950\uC7A1\uC774 \uD54D"
    alias: "\uD54D \uC2A4\uBBF8\uC2A4"
    features: "\uC791\uC740 \uD0A4, \uBE68\uAC04 \uB450\uAC74, \uC55E\uB2C8 \uD558\uB098\uAC00 \uAE08\uB2C8. \uC704\uC870 \uCE74\uB4DC \uBE0C\uB85C\uCEE4. \uAE08\uAE09 \uCE74\uB4DC\uB97C \uC790\uC8FC \uC4F4\uB2E4."
    bounty: 60
    fakeRank: 2
    look:
      label: crook_pip
      body: {fileID: 6080790682506497737, guid: ff02003c818afae49b7750d070553e48, type: 3}
      portrait: {fileID: 7620592035548990562, guid: c489e60dbd0c4ed4ab676e5549fce05f, type: 3}
      tint: {r: 1, g: 1, b: 1, a: 1}
  - name: "\uC678\uB208 \uAC00\uB81B"
    alias: "\uAC00\uB81B \uBE14\uB799"
    features: "\uC67C\uCABD \uB208\uC5D0 \uC548\uB300, \uC9E7\uC740 \uAC80\uC740 \uC218\uC5FC. \uB3C4\uC801\uB2E8 '\uAC80\uC740 \uC950'\uC758 \uB450\uBAA9. \uC804\uC0AC \uD589\uC138\uB97C \uD55C\uB2E4."
    bounty: 120
    fakeRank: 1
    look:
      label: crook_garret
      body: {fileID: 8718653499715771164, guid: a93cfd19819599b4084a9d75a80f7820, type: 3}
      portrait: {fileID: -2417104662216580140, guid: f3e3028ac2f7255438941f2953d65624, type: 3}
      tint: {r: 1, g: 1, b: 1, a: 1}
  - name: "\uB3C5\uC0AC \uB9C8\uB9AC"
    alias: "\uB9C8\uB9AC \uB85C\uC988"
    features: "\uBCF4\uB77C\uC0C9 \uAE34 \uBA38\uB9AC, \uBAA9\uC5D0 \uBC40 \uBB38\uC2E0. \uC57D\uCD08\uC0C1 \uD589\uC138\uB97C \uD558\uBA70 \uB3C5\uC744 \uD310\uB2E4."
    bounty: 90
    fakeRank: 1
    look:
      label: crook_mari
      body: {fileID: 5294133176417935440, guid: 11ce2111bf259ea4e9e0246fe621a0f6, type: 3}
      portrait: {fileID: -2665265380557916187, guid: 92327b96d3f98d340851b0da5dce8f42, type: 3}
      tint: {r: 1, g: 1, b: 1, a: 1}
  partnerGuilds: []
  fakeGuilds: []
  raid:
    title: "\uD2B8\uB864\uC758 \uB2E4\uB9AC"
    baseAttack: 48
    intro:
    - speaker: 
      text: "\uBD81\uCABD \uB2E4\uB9AC\uAC00 \uBB34\uB108\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uAC70\uB300\uD55C \uADF8\uB9BC\uC790\uAC00 \uB9C8\uC744\uB85C \uAC78\uC5B4 \uB4E4\uC5B4\uC628\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uD2B8\uB864\uC774\uC57C! \uCE7C\uB85C\uB294 \uC548 \uB3FC, \uBD88\uC774 \uD544\uC694\uD574! \uB9C8\uBC95\uC0AC\uB4E4 \uC55E\uC73C\uB85C!"
    perfect:
    - speaker: 
      text: "\uBD88\uAF43\uC774 \uD2B8\uB864\uC758 \uC0C1\uCC98\uB97C \uC9C0\uC84C\uB2E4. \uAC70\uC778\uC740 \uB2E4\uB9AC \uBC11\uC73C\uB85C \uAD74\uB7EC\uB5A8\uC5B4\uC84C\uB2E4. {defenders}\uC758 \uC774\uB984\uC774 \uBC29\uCC45\uC5D0 \uC0C8\uACA8\uC84C\uB2E4."
    - speaker: '{hero}'
      text: "\u2026\uD574\uB0C8\uC5B4. \uC811\uC218\uC6D0, \uC6B0\uB9AC \uC544\uC9C1 \uBC84\uD2F8 \uC218 \uC788\uC5B4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC798 \uBC84\uD17C\uC5B4. \uD558\uC9C0\uB9CC \uC774\uAC74 \uC2DC\uC791\uC77C \uBFD0\uC774\uC57C."
    close:
    - speaker: 
      text: "\uD2B8\uB864\uC740 \uBB3C\uB7EC\uB0AC\uC9C0\uB9CC \uBC29\uCC45 \uD55C\uCABD\uC774 \uD1B5\uC9F8\uB85C \uB0A0\uC544\uAC14\uB2E4."
    - speaker: '{hero}'
      text: "\uB2E4\uC74C\uC5D4\u2026 \uB354 \uD070 \uAC8C \uC62C \uAC70\uC57C. \uB290\uB08C\uC774 \uC548 \uC88B\uC544."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC232\uC758 \uC9D0\uC2B9\uB4E4\uC774 \uC804\uBD80 \uCAD3\uACA8 \uB0B4\uB824\uC624\uACE0 \uC788\uC5B4. \uBB54\uAC00\uAC00 \uADF8 \uB4A4\uC5D0 \uC788\uC5B4."
    fail:
    - speaker: 
      text: "\uBC29\uCC45\uC774 \uBB34\uB108\uC84C\uB2E4!! \uBE44\uBA85\uACFC \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4A4\uC11E\uC600\uB2E4."
    - speaker: 
      text: "\uADF8\uB54C, \uAE38\uB4DC 2\uCE35 \uBB38\uC774 \uC5F4\uB9AC\uACE0 \uC740\uD1F4\uD55C \uAE38\uB4DC\uC7A5\uC774 \uB0A1\uC740 \uB300\uAC80\uC744 \uB4E4\uACE0 \uB0B4\uB824\uC654\uB2E4."
    - speaker: "\uADF8\uB77C\uD568"
      text: "\u2026\uC624\uB79C\uB9CC\uC774\uAD70. \uBB3C\uB7EC\uC11C\uB77C, \uC560\uC1A1\uC774\uB4E4."
    - speaker: 
      text: "\uC801\uC740 \uBB3C\uB7EC\uB0AC\uC9C0\uB9CC \uAE38\uB4DC\uB294 \uD070 \uBE5A\uC744 \uC84C\uB2E4. \uADF8\uB77C\uD568\uC740 \uB450 \uBC88 \uB098\uC11C \uC8FC\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\uB2E4\uC74C \uC2B5\uACA9\uC5D0\uC11C \uB610 \uBB34\uB108\uC9C0\uBA74, \uC774 \uB9C8\uC744\uC740 \uB05D\uC774\uC57C."
