  title: "\uBB34\uAC70\uC6B4 \uB9C8\uC744"
  subtitle: "\uC804\uC5FC\uBCD1 \uC8FC\uAC04 \u2014 \uCE74\uB4DC \uBC88\uD638 \uD655\uC778 \uC2DC\uC791"
  tempRule: 3
