  - {fileID: 11400000, guid: f863aa1a1ba52d945b3cff42dcf394f8, type: 2}
  - {fileID: 11400000, guid: 74aeae33ce66e3a498e6f80c273eff91, type: 2}
  - {fileID: 11400000, guid: 13a4eb1787e2f1442a4ab3e03d8f67c7, type: 2}
  - {fileID: 11400000, guid: 1696f636d6bebd54a9a5d6d2bf723f44, type: 2}
  - {fileID: 11400000, guid: a776734c79a90584d9d4fa479d4e1d35, type: 2}
  - {fileID: 11400000, guid: 67e9e4a3bc88d5b409f4b34f21dd0c86, type: 2}
  - {fileID: 11400000, guid: f2ec47cd7faba3a41af5662e671a77b3, type: 2}
  - {fileID: 11400000, guid: 2c57599265534884b9ff1aaf1fb552ad, type: 2}
  - {fileID: 11400000, guid: 3f2efb3fc899061489e20b66993e14dd, type: 2}
  errandChance: 0.2
  fixedQuests:
  - day: 1
    quests:
    - {fileID: 11400000, guid: 7acbd4c4938ede744a826b7aeb4204d0, type: 2}
  intro:
  - speaker: 
    text: "\uB9C8\uC744\uC5D0 \uAE30\uCE68 \uC18C\uB9AC\uAC00 \uBC88\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4. \uCC3D\uAD6C \uC55E \uC904\uC5D0\uC11C\uB3C4 \uCF5C\uB85D\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC5ED\uBCD1\uC774\uC57C. \uC774\uBC88 \uC8FC\uC5D4 \uAE30\uCE68\uD558\uAC70\uB098 \uC548\uC0C9\uC774 \uCC3D\uBC31\uD55C \uBAA8\uD5D8\uAC00\uB294 \uC758\uB8B0\uB97C \uBABB \uBC1B\uC544. \uADDC\uC815\uC774\uC57C."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uC99D\uC0C1 \uC788\uB294 \uCC44\uB85C \uB0B4\uBCF4\uB0B4\uBA74 \uC2E4\uB825\uB3C4 \uC548 \uB098\uC624\uACE0, \uB9C8\uC744\uC5D0 \uBCD1\uB9CC \uD37C\uC838."
  - speaker: "\uB9C8\uB974\uD0C0"
    text: "\uADF8\uB9AC\uACE0 \uCE74\uB4DC \uBC88\uD638\uB3C4 \uD655\uC778\uD574. \uB3D9\uC740 B, \uC740\uC740 S, \uAE08\uC740 G\uB85C \uC2DC\uC791\uD574\uC57C \uD574. \uC704\uC870\uBC94\uB4E4\uC774 \uBC88\uD638\uAE4C\uC9C0\uB294 \uC2E0\uACBD \uBABB \uC4F0\uAC70\uB4E0."
  - speaker: "\uC138\uC2E4\uB9AC\uC544"
    text: "\uD6C4\uD6C4\u2026 \uAD1C\uCC2E\uC544\uC694. \uC81C\uAC00 \uCE58\uB8CC\uD558\uBA74 \uB418\uB2C8\uAE4C\uC694. \uC7A0\uC740\u2026 \uB098\uC911\uC5D0 \uC790\uBA74 \uB3FC\uC694."
  dayStories: []
  wanted: []
  partnerGuilds: []
  fakeGuilds: []
  raid:
    title: "\uC5ED\uBCD1 \uC18D \uB9C8\uBB3C \uB5BC"
    baseAttack: 64
    intro:
    - speaker: 
      text: "\uAE30\uCE68 \uC18C\uB9AC\uAC00 \uAC00\uB4DD\uD55C \uBC24, \uD558\uB298\uC5D0\uC11C \uB0A0\uAC1C \uC18C\uB9AC\uAC00, \uC232\uC5D0\uC11C \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB3D9\uC2DC\uC5D0 \uB4E4\uB824\uC654\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uD558\uD53C\uC5D0 \uB291\uB300\uAE4C\uC9C0\u2026 \uC544\uD508 \uC0AC\uB78C\uB4E4\uC740 \uC548\uC73C\uB85C! \uC131\uD55C \uC0AC\uB78C\uB9CC \uBC29\uCC45\uC73C\uB85C!"
    perfect:
    - speaker: 
      text: "\uC9C0\uBD95 \uC704\uC758 \uD558\uD53C\uB294 \uD654\uC0B4\uC5D0, \uB545\uC758 \uB291\uB300\uB294 \uBC29\uD328\uC5D0 \uB9C9\uD614\uB2E4. {defenders}\uC774(\uAC00) \uB05D\uAE4C\uC9C0 \uC11C \uC788\uC5C8\uB2E4."
    - speaker: '{hero}'
      text: "\u2026\uB2E4\uB4E4 \uBB34\uC0AC\uD574? \uC811\uC218\uC6D0 \uB355\uBD84\uC774\uC57C. \uC544\uD508 \uC0AC\uB78C\uC744 \uC548 \uB0B4\uBCF4\uB0B8 \uAC70."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uB2E4\uC74C \uC8FC\uC57C. \uB2E4\uC74C \uC8FC\uC5D0 \uC804\uBD80 \uB05D\uB098."
    close:
    - speaker: 
      text: "\uBA87\uBA87 \uC9C0\uBD95\uC774 \uB72F\uACA8 \uB098\uAC14\uB2E4. \uADF8\uB798\uB3C4 \uC0AC\uB78C\uC740 \uC9C0\uCF30\uB2E4."
    - speaker: '{hero}'
      text: "\uC228\uC774\u2026 \uCC28\uB124. \uADF8\uB798\uB3C4 \uBC84\uD17C\uC5B4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uC232\uC758 \uC655\uC774 \uC628\uB2E4. \uB0A8\uC740 \uD55C \uC8FC, \uC804\uBD80 \uC3DF\uC544\uBD80\uC5B4\uC57C \uD574."
    fail:
    - speaker: 
      text: "\uBC29\uCC45\uC774 \uBB34\uB108\uC84C\uB2E4!! \uBE44\uBA85\uACFC \uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4A4\uC11E\uC600\uB2E4."
    - speaker: 
      text: "\uADF8\uB54C, \uAE38\uB4DC 2\uCE35 \uBB38\uC774 \uC5F4\uB9AC\uACE0 \uC740\uD1F4\uD55C \uAE38\uB4DC\uC7A5\uC774 \uB0A1\uC740 \uB300\uAC80\uC744 \uB4E4\uACE0 \uB0B4\uB824\uC654\uB2E4."
    - speaker: "\uADF8\uB77C\uD568"
      text: "\u2026\uC624\uB79C\uB9CC\uC774\uAD70. \uBB3C\uB7EC\uC11C\uB77C, \uC560\uC1A1\uC774\uB4E4."
    - speaker: 
      text: "\uC801\uC740 \uBB3C\uB7EC\uB0AC\uC9C0\uB9CC \uAE38\uB4DC\uB294 \uD070 \uBE5A\uC744 \uC84C\uB2E4. \uADF8\uB77C\uD568\uC740 \uB450 \uBC88 \uB098\uC11C \uC8FC\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4."
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\u2026\uB2E4\uC74C \uC2B5\uACA9\uC5D0\uC11C \uB610 \uBB34\uB108\uC9C0\uBA74, \uC774 \uB9C8\uC744\uC740 \uB05D\uC774\uC57C."
