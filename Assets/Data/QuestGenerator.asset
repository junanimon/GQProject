  regions:
  - "\uC11C\uCABD \uB18D\uAC00"
  - "\uBD81\uCABD \uBAA9\uC7A5"
  - "\uC232 \uAC00\uC7A5\uC790\uB9AC"
  - "\uB9C8\uC744 \uAD11\uC7A5"
  - "\uB0A8\uCABD \uB17C"
  - "\uB3D9\uCABD \uC232\uAE38"
  - "\uC11C\uCABD \uAD11\uC0B0"
  - "\uC5B8\uB355 \uBAA9\uC7A5"
  - "\uB3D9\uCABD \uB2AA\uC9C0"
  - "\uB9C8\uC744 \uAC1C\uCC9C"
  - "\uC5EC\uAD00 '\uC878\uB9B0 \uACF0' \uB4A4\uB730"
  - "\uBD81\uCABD \uB2E4\uB9AC"
  errands:
  - title: "\uC57D\uCD08 \uC2A4\uBB34 \uBFCC\uB9AC \uCC44\uC9D1"
    description: "\uD574\uC5F4\uC6A9 \uC57D\uCD08\uAC00 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uB4B7\uC0B0 \uAC1C\uC6B8\uAC00\uC5D0 \uD754\uD569\uB2C8\uB2E4."
    proof: "\uD574\uC5F4\uCD08 20\uBFCC\uB9AC"
    reward: 60
  - title: "\uC606 \uB9C8\uC744\uAE4C\uC9C0 \uD3B8\uC9C0 \uBC30\uB2EC"
    description: "\uAE09\uD55C \uD3B8\uC9C0 \uD55C \uD1B5\uC785\uB2C8\uB2E4. \uBC1B\uC558\uB2E4\uB294 \uB3C4\uC7A5\uC744 \uAF2D \uBC1B\uC544 \uC624\uC138\uC694."
    proof: "\uC218\uB839 \uD655\uC778 \uB3C4\uC7A5"
    reward: 40
  - title: "\uC783\uC5B4\uBC84\uB9B0 \uBC18\uC9C0\uB97C \uCC3E\uC544\uC8FC\uC138\uC694"
    description: "\uBE68\uB798\uD130\uC5D0\uC11C \uACB0\uD63C\uBC18\uC9C0\uB97C \uC783\uC5B4\uBC84\uB838\uC5B4\uC694. \uC740\uBC18\uC9C0\uC5D0 \uC791\uC740 \uD478\uB978 \uB3CC\uC774 \uBC15\uD600 \uC788\uC5B4\uC694."
    proof: "\uD478\uB978 \uB3CC \uC740\uBC18\uC9C0"
    reward: 70
  - title: "\uCD95\uC81C \uC7A5\uC2DD \uB2EC\uAE30"
    description: "\uAD11\uC7A5\uC5D0 \uB4F1\uBD88\uC744 \uB9E4\uB2EC \uC0AC\uB78C\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uB192\uC740 \uB370 \uBB34\uC11C\uC6CC\uD558\uC9C0 \uC54A\uB294 \uBD84!"
    proof: "\uAD11\uC7A5 \uAD00\uB9AC\uC778 \uD655\uC778\uC11C"
    reward: 50
  - title: "\uB3C4\uB9DD\uAC04 \uC5FC\uC18C \uB370\uB824\uC624\uAE30"
    description: "\uC6B0\uB9AC \uC5FC\uC18C '\uB300\uC7A5'\uC774 \uB610 \uB3C4\uB9DD\uAC14\uC5B4\uC694. \uBFD4\uC5D0 \uBE68\uAC04 \uB9AC\uBCF8\uC744 \uB9E4\uACE0 \uC788\uC5B4\uC694."
    proof: "\uC5FC\uC18C '\uB300\uC7A5'"
    reward: 45
  - title: "\uC6B0\uBB3C \uCCAD\uC18C"
    description: "\uC6B0\uBB3C \uBC14\uB2E5\uC5D0 \uB099\uC5FD\uC774 \uC794\uB729 \uC313\uC600\uC5B4\uC694. \uBC27\uC904\uC740 \uC800\uD76C\uAC00 \uBE4C\uB824\uB4DC\uB824\uC694."
    proof: "\uC774\uC7A5 \uD655\uC778\uC11C"
    reward: 55
  - title: "\uC57D \uBC30\uB2EC (\uACE0\uC544\uC6D0)"
    description: "\uACE0\uC544\uC6D0 \uC6D0\uC7A5\uB2D8\uAED8 \uAE30\uCE68\uC57D\uC744 \uC804\uD574 \uC8FC\uC138\uC694. \uAF2D \uC624\uB298 \uC548\uC5D0\uC694."
    proof: "\uC6D0\uC7A5 \uC11C\uBA85"
    reward: 35
  - title: "\uC7A5\uC791 \uD328\uAE30"
    description: "\uACA8\uC6B8 \uC900\uBE44\uB85C \uC7A5\uC791 \uC11C\uB978 \uB2E8\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uB3C4\uB07C\uB294 \uB4DC\uB9BD\uB2C8\uB2E4."
    proof: "\uC7A5\uC791 30\uB2E8"
    reward: 60
  exaggerateLines:
  - "\uC801\uC5B4\uB3C4 {n}\uB9C8\uB9AC\uB294 \uB420 \uAC70\uC608\uC694!!"
  - "\uC140 \uC218\uB3C4 \uC5C6\uC5B4\uC694! {n}\uB9C8\uB9AC? \uC544\uB2C8 \uADF8 \uC774\uC0C1!"
  - "\uC628 \uB9C8\uC744\uC774 {n}\uB9C8\uB9AC\uD55C\uD14C \uD3EC\uC704\uB410\uB2E4\uB2C8\uAE4C\uC694!"
  understateLines:
  - "\uBB50, {n}\uB9C8\uB9AC\uCBE4\uC774\uC624. \uBCC4\uC77C \uC544\uB2C8\uB2C8 \uC2F8\uAC8C \uBD80\uD0C1\uD558\uC624."
  - "{n}\uB9C8\uB9AC \uC815\uB3C4? \uB300\uCDA9 \uADF8 \uC815\uB3C4\uC77C \uAC70\uC694."
  - "\uADF8\uB9AC \uB9CE\uC9C0\uB294 \uC54A\uC18C. \uD55C {n}\uB9C8\uB9AC?"
  accurateLines:
  - "\uC9C1\uC811 \uC138\uC5B4 \uBCF4\uB2C8 {n}\uB9C8\uB9AC\uC600\uC2B5\uB2C8\uB2E4."
  - "\uD655\uC778\uD55C \uAC83\uB9CC {n}\uB9C8\uB9AC\uC785\uB2C8\uB2E4."
  - "\uC815\uD655\uD788 {n}\uB9C8\uB9AC \uBD24\uC5B4\uC694."
  truthHints:
  - "\u2026\uADF8\uB7F0\uB370 \uB098\uC911\uC5D0 \uAC00 \uBCF4\uB2C8 {trace}."
  - "(\uC606\uC9D1 \uC0AC\uB78C \uB9D0\uB85C\uB294 {trace}.)"
  - "\uB2E4\uB9CC, {trace}."
  misnameLines:
  - "\uC544\uB9C8 {other}\uC77C \uAC70\uC608\uC694."
  - "{other} \uAC19\uB358\uB370\uC694, \uBB50."
  - "\uC81C \uC0DD\uAC01\uC5D4 {other}\uC608\uC694. \uD2C0\uB9BC\uC5C6\uC5B4\uC694."
