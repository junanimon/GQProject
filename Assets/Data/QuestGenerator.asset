  - label: "\uBE0C\uB78C (\uBAA9\uC7A5\uC8FC, \uBB34\uB69D\uB69D\uD568)"
    tone: 2
  - label: "\uC5EC\uAD00 \uC8FC\uC778 (\uB290\uAE0B\uD568)"
    tone: 2
  - label: "\uB3C4\uB974\uD504 (\uAD11\uBD80 \uC870\uD569\uC7A5, \uD22C\uB35C\uAC70\uB9BC)"
    tone: 2
  - label: "\uD55C\uB098 (\uBE75\uC9D1 \uC8FC\uC778, \uCE68\uCC29\uD568)"
    tone: 0
  - label: "\uB9C8\uC744 \uC774\uC7A5 (\uC2E0\uC911\uD568)"
