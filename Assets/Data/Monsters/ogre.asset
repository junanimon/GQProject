  id: ogre
  displayName: "\uC624\uC6B0\uAC70"
  talkName: "\uC624\uC6B0\uAC70"
  features: "\uC624\uD06C\uBCF4\uB2E4 \uB450 \uBC30\uB294 \uD070 \uAC70\uC778. \uD63C\uC790 \uB2E4\uB2C8\uBA70 \uD1B5\uB098\uBB34\uB97C \uBABD\uB465\uC774\uB85C \uC4F4\uB2E4. \uB9D0\uC774 \uC11C\uD234\uACE0 \uBA39\uC744 \uAC83\uC5D0 \uC57D\uD558\uB2E4. \uD798\uC73C\uB85C\uB294 \uB2F9\uD574 \uB0BC \uC218 \uC5C6\uC5B4 \uBA40\uB9AC\uC11C \uC3D8\uB294 \uAD81\uC218\uAC00 \uD544\uC694\uD558\uB2E4. \uC624\uD06C\uCC98\uB7FC \uBB34\uB9AC \uC9D3\uAC70\uB098 \uCC3D\uC744 \uC4F0\uC9C0 \uC54A\uB294\uB2E4."
  illustration: {fileID: 8539566862590955623, guid: 9b6dd05c5503d344ab4d33d6dd77b854, type: 3}
  illustrationTint: {r: 0.56, g: 0.46, b: 0.34, a: 1}
  evidenceName: "\uC624\uC6B0\uAC70 \uC5B4\uAE08\uB2C8"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.56, g: 0.46, b: 0.34, a: 1}
  clues:
  - "\uC9C0\uBD95\uBCF4\uB2E4 \uBA38\uB9AC\uAC00 \uB192\uC740 \uAC8C \uD1B5\uB098\uBB34\uB97C \uC9C8\uC9C8 \uB04C\uACE0 \uAC14\uC5B4\uC694."
  - "\uC18C\uB97C \uD1B5\uC9F8\uB85C \uB4E4\uCCD0 \uBA54\uACE0 \uAC14\uC5B4\uC694. \uD63C\uC790\uC11C\uC694."
  - "'\uBC30\uACE0\uD30C\u2026' \uD558\uACE0 \uAD75\uC740 \uBAA9\uC18C\uB9AC\uB85C \uC911\uC5BC\uAC70\uB838\uC5B4\uC694."
  - "\uBC1C\uC790\uAD6D \uC548\uC5D0 \uC81C\uAC00 \uB4E4\uC5B4\uAC00 \uB204\uC6B8 \uC218 \uC788\uC5B4\uC694."
