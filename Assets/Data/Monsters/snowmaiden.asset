  id: snowmaiden
  displayName: "\uC124\uB140"
  talkName: "\uC124\uB140"
  features: "\uB208\uBCF4\uB77C \uCE58\uB294 \uBC24, \uAE38 \uC783\uC740 \uC0AC\uB78C \uC55E\uC5D0 \uB098\uD0C0\uB098\uB294 \uD558\uC580 \uC637\uC758 \uC5EC\uC778. \uC785\uB9DE\uCDA4\uD558\uB4EF \uC228\uC744 \uBD88\uC5B4 \uBAB8\uC744 \uC5BC\uB9B0\uB2E4. \uB9C8\uC74C\uAE4C\uC9C0 \uC5BC\uC5B4\uBD99\uAC8C \uD558\uBBC0\uB85C \uC628\uAE30\uB97C \uB418\uCC3E\uC544 \uC904 \uC131\uC9C1\uC790\uAC00 \uD544\uC694\uD558\uB2E4. \uB2AA \uB9DD\uB839\uACFC \uB2EC\uB9AC \uBAB8\uC774 \uC788\uACE0 \uB208 \uC704\uC5D0 \uB9E8\uBC1C \uC790\uAD6D\uC774 \uB0A8\uB294\uB2E4."
  illustration: {fileID: 3574354140817508323, guid: c63eded1a3c3f23448e6520d659512bd, type: 3}
  illustrationTint: {r: 0.86, g: 0.9, b: 1, a: 1}
  evidenceName: "\uC124\uB140\uC758 \uC5BC\uC74C \uBA38\uB9AC\uD540"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.86, g: 0.9, b: 1, a: 1}
  clues:
  - "\uB208\uBCF4\uB77C \uC18D\uC5D0 \uD558\uC580 \uC637 \uC785\uC740 \uC5EC\uC790\uAC00 \uC11C \uC788\uC5C8\uC5B4\uC694. \uC2E0\uBC1C\uC744 \uC548 \uC2E0\uC5C8\uC5B4\uC694."
  - "\uCD08\uC18C\uBCD1\uC774 \uBC24\uC5D0 \uB204\uAD74 \uB530\uB77C \uB098\uAC14\uB2E4\uAC00 \uC0C8\uBCBD\uC5D0 \uC5BC\uC5B4\uC11C \uBC1C\uACAC\uB410\uC5B4\uC694. \uC6C3\uACE0 \uC788\uC5C8\uB300\uC694."
  - "\uB208 \uC704\uC5D0 \uB9E8\uBC1C \uC790\uAD6D\uC774 \uC774\uC5B4\uC9C0\uB2E4\uAC00 \uB04A\uACBC\uC5B4\uC694."
  - "\uCC28\uAC00\uC6B4 \uC228\uC774 \uBAA9\uB35C\uBBF8\uC5D0 \uB2FF\uC558\uB294\uB370, \uADF8 \uB4A4\uB85C \uC544\uBB34\uAC83\uB3C4 \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uC544\uC694."
  questTitles:
  - "\uB208\uBCF4\uB77C \uC18D \uD558\uC580 \uC637\uC758 \uC5EC\uC778"
