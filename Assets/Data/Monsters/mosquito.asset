  id: mosquito
  displayName: "\uBAA8\uAE30 \uB5BC"
  talkName: "\uBAA8\uAE30 \uB5BC"
  features: "\uC8FC\uBA39\uB9CC \uD55C \uBAA8\uAE30\uAC00 \uAD6C\uB984\uCC98\uB7FC \uBAB0\uB824\uB2E4\uB2CC\uB2E4. \uC575\u2014 \uD558\uB294 \uC18C\uB9AC\uAC00 \uBA40\uB9AC\uC11C\uB3C4 \uB4E4\uB9B0\uB2E4. \uD53C\uB97C \uBE68\uACE0 \uAC00\uB824\uC6B4 \uC790\uAD6D\uC744 \uB0A8\uAE34\uB2E4. \uCE7C\uB85C\uB294 \uC218\uAC00 \uB9CE\uC544 \uC18C\uC6A9\uC5C6\uACE0 \uBD88 \xB7 \uC5F0\uAE30\uB85C \uCAD3\uB294 \uB9C8\uBC95\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uAC70\uBA38\uB9AC\uC640 \uB2EC\uB9AC \uBB3C \uBC16\uC5D0\uC11C\uB3C4 \uB0A0\uC544\uC640 \uBB38\uB2E4."
  illustration: {fileID: -5064401156898091283, guid: dccbbfb7f5493454cb869ca66f9dfdc5, type: 3}
  illustrationTint: {r: 0.42, g: 0.42, b: 0.36, a: 1}
  evidenceName: "\uBAA8\uAE30 \uB0A0\uAC1C"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.42, g: 0.42, b: 0.36, a: 1}
  clues:
  - "\uD574 \uC9C8 \uB158\uC5D0 \uC575\u2014 \uD558\uB294 \uC18C\uB9AC\uAC00 \uB098\uB354\uB2C8 \uAC80\uC740 \uAD6C\uB984\uC774 \uBAB0\uB824\uC654\uC5B4\uC694."
  - "\uD558\uB8FB\uBC24 \uC0AC\uC774\uC5D0 \uC628\uBAB8\uC5D0 \uBD89\uC740 \uC790\uAD6D\uC774 \uC218\uC2ED \uAC1C \uC0DD\uACBC\uC5B4\uC694. \uB108\uBB34 \uAC00\uB824\uC6CC\uC694."
  - "\uCC3D\uBB38\uC5D0 \uBB54\uAC00 \uD1A1\uD1A1 \uBD80\uB52A\uD600\uC694. \uC8FC\uBA39\uB9CC \uD55C \uBAA8\uAE30\uC608\uC694!"
  - "\uBAA8\uB2E5\uBD88\uC744 \uD53C\uC6E0\uB354\uB2C8 \uADF8\uCABD\uC73C\uB85C\uB294 \uC548 \uC624\uB354\uB77C\uACE0\uC694."
