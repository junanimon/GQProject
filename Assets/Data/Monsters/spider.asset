  evidenceTint: {r: 0.28, g: 0.22, b: 0.32, a: 1}
  clues:
  - "\uC232\uAE38 \uB098\uBB34 \uC0AC\uC774\uC5D0 \uD558\uC580 \uCC9C \uAC19\uC740 \uAC8C \uCCD0\uC838 \uC788\uC5B4\uC694. \uB048\uC801\uD574\uC11C \uC190\uC774 \uC548 \uB5A8\uC5B4\uC838\uC694."
  - "\uB098\uBB47\uAC00\uC9C0\uC5D0 \uC0AC\uB78C \uD314\uB69D\uB9CC \uD55C \uD558\uC580 \uBB49\uCE58\uAC00 \uB9E4\uB2EC\uB824 \uC788\uC5C8\uC5B4\uC694. \uC548\uC5D0\uC11C \uBB54\uAC00 \uAFC8\uD2C0\uD588\uC5B4\uC694."
  - "\uB538\uAE4D\uB538\uAE4D, \uB098\uBB34 \uC704\uC5D0\uC11C \uBB54\uAC00 \uC774\uBE68 \uBD80\uB52A\uCE58\uB294 \uC18C\uB9AC\uAC00 \uB098\uC694."
  - "\uC0AC\uB0E5\uAC1C\uAC00 \uC232\uC5D0 \uB4E4\uC5B4\uAC00\uB354\uB2C8 \uB2E4\uB9AC\uB97C \uC808\uBA74\uC11C \uB098\uC654\uC5B4\uC694. \uBB3C\uB9B0 \uC790\uB9AC\uAC00 \uBCF4\uB78F\uBE5B\uC73C\uB85C \uBD80\uC5C8\uC5B4\uC694."
