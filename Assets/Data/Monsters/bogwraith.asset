  id: bogwraith
  displayName: "\uB2AA \uB9DD\uB839"
  talkName: "\uB2AA \uB9DD\uB839"
  features: "\uC548\uAC1C\uAC00 \uC0AC\uB78C \uBAA8\uC591\uC73C\uB85C \uBB49\uCE5C \uB9DD\uB839. \uC774\uB984\uC744 \uBD80\uB974\uBA70 \uB2AA \uAE4A\uC740 \uACF3\uC73C\uB85C \uB04C\uC5B4\uB4E4\uC778\uB2E4. \uBC1C\uC790\uAD6D\uC774 \uC5C6\uACE0 \uBB34\uAE30\uAC00 \uD1B5\uACFC\uD55C\uB2E4. \uB9C8\uBC95\uC73C\uB85C\uB9CC \uD769\uC744 \uC218 \uC788\uB2E4. \uB2AA \uB9C8\uB140\uC640 \uB2EC\uB9AC \uBAB8\uC774 \uBE44\uCE58\uACE0, \uC624\uB450\uB9C9\uC774\uB098 \uB0C4\uBE44 \uAC19\uC740 \uC0B4\uB9BC \uD754\uC801\uC774 \uC5C6\uB2E4."
  illustration: {fileID: 3574354140817508323, guid: c63eded1a3c3f23448e6520d659512bd, type: 3}
  illustrationTint: {r: 0.7, g: 0.8, b: 0.86, a: 1}
  evidenceName: "\uC548\uAC1C \uC218\uC815"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.7, g: 0.8, b: 0.86, a: 1}
  clues:
  - "\uC548\uAC1C \uC18D\uC5D0\uC11C \uB3CC\uC544\uAC00\uC2E0 \uD560\uBA38\uB2C8 \uBAA9\uC18C\uB9AC\uAC00 \uC81C \uC774\uB984\uC744 \uBD88\uB800\uC5B4\uC694."
  - "\uC0AC\uB78C \uBAA8\uC591 \uC548\uAC1C\uAC00 \uC11C \uC788\uB294\uB370 \uB4A4\uAC00 \uBE44\uCCD0 \uBCF4\uC600\uC5B4\uC694. \uBC1C\uC790\uAD6D\uC740 \uC5C6\uC5C8\uACE0\uC694."
  - "\uB0AB\uC744 \uD718\uB458\uB800\uB294\uB370 \uC5F0\uAE30\uCC98\uB7FC \uD769\uC5B4\uC84C\uB2E4\uAC00 \uB2E4\uC2DC \uBB49\uCCE4\uC5B4\uC694."
  - "\uADF8 \uB4A4\uB85C \uC0AC\uB0E5\uAFBC \uD55C \uBA85\uC774 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uC5B4\uC694."
  questTitles:
  - "\uC774\uB984\uC744 \uBD80\uB974\uB294 \uC548\uAC1C"
  - "\uBE44\uCCD0 \uBCF4\uC774\uB294 \uC0AC\uB78C"
