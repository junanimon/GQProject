  id: hydra
  displayName: "\uD788\uB4DC\uB77C \uC0C8\uB07C"
  talkName: "\uD788\uB4DC\uB77C"
  features: "\uBA38\uB9AC\uAC00 \uC14B \uB2EC\uB9B0 \uB2AA \uBC40. \uBAA9\uC744 \uBCA0\uBA74 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uB458\uC774 \uB3CB\uB294\uB2E4. \uBCA0\uC5B4 \uB0B8 \uC790\uB9AC\uB97C \uBD88\uB85C \uC9C0\uC838\uC57C \uD574\uC11C \uB9C8\uBC95\uC0AC\uAC00 \uAF2D \uD544\uC694\uD558\uB2E4. \uC0C8\uB07C\uB77C\uB3C4 \uAE08\uAE09 \uC758\uB8B0. \uB300\uC655 \uBC40\uACFC \uB2EC\uB9AC \uB2E4\uB9AC\uAC00 \uC788\uACE0, \uBC1C\uC790\uAD6D \uC606\uC5D0 \uBAA9 \uC5EC\uB7EC \uAC1C\uAC00 \uB048 \uC790\uAD6D\uC774 \uB09C\uB2E4."
  illustration: {fileID: 6625497298562620416, guid: cc6370c13fc45d74ea0d0d3a39b07721, type: 3}
  illustrationTint: {r: 0.4, g: 0.6, b: 0.46, a: 1}
  evidenceName: "\uD788\uB4DC\uB77C \uBAA9 \uBE44\uB298"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.4, g: 0.6, b: 0.46, a: 1}
  clues:
  - "\uBA38\uB9AC\uAC00 \uC5EC\uB7FF \uB2EC\uB9B0 \uAC8C \uBB3C \uC704\uB85C \uACE0\uAC1C\uB97C \uCCD0\uB4E4\uC5C8\uC5B4\uC694. \uC14B\uC740 \uB410\uC5B4\uC694."
  - "\uC5B4\uBD80\uAC00 \uBA38\uB9AC \uD558\uB098\uB97C \uC791\uC0B4\uB85C \uCC14\uB800\uB294\uB370, \uB2E4\uC74C \uB0A0 \uBCF4\uB2C8 \uB354 \uB298\uC5C8\uB300\uC694."
  - "\uC9C4\uD759\uC5D0 \uB124 \uBC1C \uC790\uAD6D \uC606\uC73C\uB85C \uC5EC\uB7EC \uAC08\uB798 \uB048 \uC790\uAD6D\uC774 \uC788\uC5B4\uC694."
  - "\uC26C\uC774\uC775, \uC18C\uB9AC\uAC00 \uD55C\uAEBC\uBC88\uC5D0 \uC5EC\uB7EC \uAD70\uB370\uC11C \uB0AC\uC5B4\uC694."
