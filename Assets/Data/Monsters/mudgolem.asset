  id: mudgolem
  displayName: "\uC9C4\uD759 \uACE8\uB818"
  talkName: "\uC9C4\uD759 \uACE8\uB818"
  features: "\uB2AA \uC9C4\uD759\uC774 \uBB49\uCCD0 \uC77C\uC5B4\uB09C \uAC70\uC778. \uB9DE\uC73C\uBA74 \uC9C4\uD759\uC774 \uD280\uACE0, \uBD80\uC11C\uC9C4 \uACF3\uC774 \uB2E4\uC2DC \uBD99\uB294\uB2E4. \uBC14\uC704 \uACE8\uB818\uBCF4\uB2E4 \uC57D\uD558\uC9C0\uB9CC \uBB3C\uAC00\uC5D0\uC120 \uACC4\uC18D \uD68C\uBCF5\uD55C\uB2E4. \uBB4D\uC73C\uB85C \uB04C\uC5B4\uB0B4 \uC804\uC0AC\uAC00 \uD575\uC744 \uBD80\uC234\uC57C \uD55C\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uC9C4\uD759 \uC904\uAE30\uAC00 \uB0A8\uB294\uB2E4."
  illustration: {fileID: 8539566862590955623, guid: 9b6dd05c5503d344ab4d33d6dd77b854, type: 3}
  illustrationTint: {r: 0.46, g: 0.36, b: 0.26, a: 1}
  evidenceName: "\uC9C4\uD759 \uD575"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.46, g: 0.36, b: 0.26, a: 1}
  clues:
  - "\uB451\uC774 \uC77C\uC5B4\uB098\uC11C \uAC78\uC5B4\uAC14\uC5B4\uC694. \uC9C4\uD759\uC774 \uB69D\uB69D \uB5A8\uC5B4\uC84C\uC5B4\uC694."
  - "\uBABD\uB465\uC774\uB85C \uCCE4\uB354\uB2C8 \uAD6C\uBA4D\uC774 \uB0AC\uB294\uB370, \uC9C4\uD759\uC774 \uD758\uB7EC \uB4E4\uC5B4\uAC00 \uAE08\uBC29 \uBA54\uC6CC\uC84C\uC5B4\uC694."
  - "\uBC2D\uAE4C\uC9C0 \uC9C4\uD759 \uC904\uAE30\uAC00 \uAE38\uAC8C \uC774\uC5B4\uC838 \uC788\uC5B4\uC694."
  - "\uAC00\uC2B4 \uC18D\uC5D0\uC11C \uCD08\uB85D\uBE5B\uC774 \uD76C\uBBF8\uD558\uAC8C \uBCF4\uC600\uC5B4\uC694."
  questTitles:
  - "\uAC78\uC5B4 \uB2E4\uB2C8\uB294 \uB451"
  - "\uBA54\uC6CC\uC9C0\uB294 \uAD6C\uBA4D"
  - "\uBC2D\uAE4C\uC9C0 \uC774\uC5B4\uC9C4 \uC9C4\uD759"
  countTrace: "\uC9C4\uD759 \uC904\uAE30\uAC00 {n}\uAC08\uB798\uB85C \uC774\uC5B4\uC838 \uC788\uC5C8\uB2E4"
