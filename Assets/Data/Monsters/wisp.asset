  id: wisp
  displayName: "\uB3C4\uAE68\uBE44\uBD88"
  talkName: "\uB3C4\uAE68\uBE44\uBD88"
  features: "\uC8FC\uBA39\uB9CC \uD55C \uD478\uB978 \uBD88\uC774 \uC0AC\uB78C \uD5C8\uB9AC \uB192\uC774\uC5D0\uC11C \uB5A0\uB2E4\uB2CC\uB2E4. \uC18C\uB9AC\uAC00 \uC804\uD600 \uC5C6\uACE0, \uB530\uB77C\uAC00\uBA74 \uAE38\uC744 \uC783\uB294\uB2E4. \uB0A0\uAC1C\uB3C4 \uAC00\uB8E8\uB3C4 \uC5C6\uB2E4. \uCE7C\uACFC \uD654\uC0B4\uC774 \uADF8\uB0E5 \uD1B5\uACFC\uD574\uC11C \uB9C8\uBC95\uC73C\uB85C\uB9CC \uAEBC\uB728\uB9B4 \uC218 \uC788\uB2E4. \uAEBC\uC9C0\uBA74 \uB530\uB73B\uD55C \uB3CC\uBA69\uC774\uAC00 \uB0A8\uB294\uB2E4."
  illustration: {fileID: 4569161321755363472, guid: 771817a0c32124041ab0c30c861ef3b3, type: 3}
  illustrationTint: {r: 0.55, g: 0.9, b: 1, a: 1}
