  displayName: "\uAD6C\uC6B8"
  talkName: "\uAD6C\uC6B8"
  features: "\uBB34\uB364\uC744 \uD30C\uD5E4\uCCD0 \uC2DC\uCCB4\uB97C \uBA39\uB294 \uC7BF\uBE5B \uAD34\uBB3C. \uC190\uD1B1\uC5D0 \uAE01\uD788\uBA74 \uBAB8\uC774 \uB9C8\uBE44\uB41C\uB2E4. \uC369\uC740 \uB0C4\uC0C8\uAC00 \uC9C0\uB3C5\uD558\uB2E4. \uB9C8\uBE44\uB97C \uD480\uC5B4 \uC904 \uC131\uC9C1\uC790\uAC00 \uD544\uC694\uD558\uB2E4. \uD574\uACE8 \uBCD1\uC0AC\uC640 \uB2EC\uB9AC \uC0B4\uC774 \uBD99\uC5B4 \uC788\uACE0 \uB124 \uBC1C\uB85C \uAE30\uAE30\uB3C4 \uD55C\uB2E4."
