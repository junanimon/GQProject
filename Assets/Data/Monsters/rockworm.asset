  id: rockworm
  displayName: "\uAD11\uC11D \uBC8C\uB808"
  talkName: "\uAD11\uC11D \uBC8C\uB808"
  features: "\uC18C \uD55C \uB9C8\uB9AC\uB9CC \uD55C \uBC8C\uB808. \uB3CC\uACFC \uAD11\uC11D\uC744 \uAC09\uC544 \uBA39\uC73C\uBA70 \uB545\uC18D\uC5D0 \uB465\uADFC \uAD74\uC744 \uD310\uB2E4. \uBC1C\uBC11\uC5D0\uC11C \uAC11\uC790\uAE30 \uD280\uC5B4\uB098\uC628\uB2E4. \uD131\uC774 \uB2E8\uB2E8\uD574 \uC55E\uC5D0\uC11C \uB9C9\uC544 \uC904 \uC804\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uAC1C\uBBF8\uC640 \uB2EC\uB9AC \uAD74\uC774 \uD06C\uACE0 \uD558\uB098\uBFD0\uC774\uBA70, \uD63C\uC790 \uB2E4\uB2CC\uB2E4."
  illustration: {fileID: 4569161321755363472, guid: 771817a0c32124041ab0c30c861ef3b3, type: 3}
  illustrationTint: {r: 0.62, g: 0.48, b: 0.38, a: 1}
  evidenceName: "\uAD11\uC11D \uBC8C\uB808 \uD131"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.62, g: 0.48, b: 0.38, a: 1}
  clues:
  - "\uAC31\uB3C4 \uBCBD\uC5D0 \uB3D9\uADF8\uB780 \uAD74\uC774 \uC0C8\uB85C \uB6AB\uB838\uC5B4\uC694. \uC0AC\uB78C\uC774 \uC11C\uC11C \uB4E4\uC5B4\uAC08 \uB9CC\uD574\uC694."
  - "\uCE90 \uB193\uC740 \uCCA0\uAD11\uC11D \uB354\uBBF8\uAC00 \uD558\uB8FB\uBC24 \uC0C8 \uBC18\uC73C\uB85C \uC904\uC5C8\uC5B4\uC694."
  - "\uBC1C\uBC11\uC5D0\uC11C \uB4DC\uB974\uB975 \uAC09\uB294 \uC18C\uB9AC\uAC00 \uB098\uB354\uB2C8 \uB545\uC774 \uAEBC\uC84C\uC5B4\uC694."
  - "\uAD74 \uC548\uCABD \uBCBD\uC774 \uB9E4\uB048\uD558\uAC8C \uAC08\uB824 \uC788\uC5B4\uC694. \uC774\uBE68 \uC790\uAD6D \uAC19\uC740 \uD648\uC774 \uC788\uACE0\uC694."
  questTitles:
  - "\uCCA0\uAD11\uC11D\uC774 \uC0AC\uB77C\uC838\uC694"
  - "\uBC1C\uBC11\uC5D0\uC11C \uAC09\uB294 \uC18C\uB9AC"
  - "\uC0C8\uB85C \uB6AB\uB9B0 \uD070 \uAD74"
  countTrace: "\uC0AC\uB78C\uC774 \uC11C\uC11C \uB4E4\uC5B4\uAC08 \uB9CC\uD55C \uAD74\uC774 {n}\uAC1C \uB6AB\uB824 \uC788\uC5C8\uB2E4"
