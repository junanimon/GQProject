  illustrationTint: {r: 0.3, g: 0.2, b: 0.26, a: 1}
  evidenceName: "\uAC70\uBA38\uB9AC \uBAB8\uD1B5"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.3, g: 0.2, b: 0.26, a: 1}
  clues:
  - "\uB2AA\uC744 \uAC74\uB108\uACE0 \uB098\uB2C8 \uB2E4\uB9AC\uC5D0 \uAC80\uBD89\uC740 \uAC8C \uC5EC\uB7EC \uAC1C \uBD99\uC5B4 \uC788\uC5C8\uC5B4\uC694."
  - "\uBB3C\uB9B0 \uC790\uB9AC\uAC00 \uB3D9\uADF8\uB797\uAC8C \uD1B1\uB2C8 \uBAA8\uC591\uC774\uC5D0\uC694. \uACEA\uC544\uC11C \uC5F4\uC774 \uB098\uC694."
  - "\uBB3C\uC18C\uAC00 \uBB3C\uC5D0\uC11C \uB098\uC624\uB354\uB2C8 \uBE44\uD2C0\uAC70\uB9AC\uB2E4 \uC4F0\uB7EC\uC84C\uC5B4\uC694. \uD53C\uAC00 \uC5C6\uB300\uC694."
  - "\uC18C\uB9AC\uB3C4 \uC5C6\uC5C8\uC5B4\uC694. \uBB3C \uBC16\uC5D0 \uB098\uC640\uC11C\uC57C \uC54C\uC558\uC5B4\uC694."
