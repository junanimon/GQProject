  id: leech
  displayName: "\uB2AA \uAC70\uBA38\uB9AC"
  talkName: "\uAC70\uBA38\uB9AC"
  features: "\uD314\uB69D\uB9CC \uD55C \uAC80\uBD89\uC740 \uAC70\uBA38\uB9AC. \uBB3C\uC18D\uC5D0\uC11C \uB2E4\uB9AC\uC5D0 \uB2EC\uB77C\uBD99\uC5B4 \uD53C\uB97C \uBE64\uB2E4. \uBB3C\uB9B0 \uC790\uB9AC\uAC00 \uACEA\uC544 \uC5F4\uC774 \uB098\uBBC0\uB85C \uC131\uC9C1\uC790\uAC00 \uD544\uC694\uD558\uB2E4. \uBAA8\uAE30\uC640 \uB2EC\uB9AC \uB0A0\uC9C0 \uC54A\uACE0, \uC18C\uB9AC \uC5C6\uC774 \uBB3C\uC18D\uC5D0\uC11C\uB9CC \uBD99\uB294\uB2E4. \uBB3C\uB9B0 \uC790\uAD6D\uC774 \uB3D9\uADF8\uB780 \uD1B1\uB2C8 \uBAA8\uC591\uC774\uB2E4."
