  id: skeleton
  displayName: "\uD574\uACE8 \uBCD1\uC0AC"
  talkName: "\uD574\uACE8 \uBCD1\uC0AC"
  features: "\uC61B \uC804\uC7C1\uD130 \uBB34\uB364\uC5D0\uC11C \uC77C\uC5B4\uB09C \uD574\uACE8. \uB179\uC2A8 \uCE7C\uACFC \uBC29\uD328\uB97C \uB4E4\uACE0 \uBC24\uC5D0 \uD589\uAD70\uD55C\uB2E4. \uB2EC\uADF8\uB77D\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4. \uBF08\uB77C\uC11C \uCE7C\uB0A0\uBCF4\uB2E4 \uB454\uAE30\uAC00 \uC798 \uBA39\uD78C\uB2E4 \u2014 \uC804\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uAD6C\uC6B8\uACFC \uB2EC\uB9AC \uC0B4\uC810\uC774 \uC5C6\uACE0 \uC2DC\uCCB4\uB97C \uBA39\uC9C0 \uC54A\uB294\uB2E4."
  illustration: {fileID: 3574354140817508323, guid: c63eded1a3c3f23448e6520d659512bd, type: 3}
  illustrationTint: {r: 0.9, g: 0.88, b: 0.8, a: 1}
  evidenceName: "\uD574\uACE8 \uBF1B\uC870\uAC01"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.9, g: 0.88, b: 0.8, a: 1}
  clues:
  - "\uBC24\uC5D0 \uB2EC\uADF8\uB77D, \uB2EC\uADF8\uB77D \uD558\uB294 \uC18C\uB9AC\uAC00 \uC904\uC9C0\uC5B4 \uC9C0\uB098\uAC14\uC5B4\uC694."
  - "\uC61B \uBB34\uB364 \uD759\uC774 \uBC16\uC73C\uB85C \uD30C\uD5E4\uCCD0\uC838 \uC788\uC5B4\uC694. \uC548\uC5D0\uC11C \uB098\uC628 \uAC83\uCC98\uB7FC\uC694."
  - "\uB179\uC2A8 \uCE7C\uC744 \uB4E0 \uD574\uACE8\uC774 \uBCF4\uCD08\uCC98\uB7FC \uC11C \uC788\uC5C8\uC5B4\uC694."
  - "\uD654\uC0B4\uC744 \uC408\uB354\uB2C8 \uAC08\uBE44\uBF08 \uC0AC\uC774\uB85C \uADF8\uB0E5 \uBE60\uC838\uB098\uAC14\uC5B4\uC694."
