  id: hornrabbit
  displayName: "\uBFD4\uD1A0\uB07C"
  talkName: "\uBFD4\uD1A0\uB07C"
  features: "\uC774\uB9C8\uC5D0 \uC791\uC740 \uBFD4\uC774 \uB09C \uD770 \uD1A0\uB07C. \uB5BC\uB85C \uBAB0\uB824\uC640 \uCC44\uC18C\uBC2D \uC78E\uC744 \uAC09\uB294\uB2E4. \uAC81\uC774 \uB9CE\uC9C0\uB9CC \uAD81\uC9C0\uC5D0 \uBAB0\uB9AC\uBA74 \uBFD4\uB85C \uCC0C\uB978\uB2E4. \uC950\uC640 \uB2EC\uB9AC \uAF2C\uB9AC\uAC00 \uC9E7\uACE0 \uB4B7\uB2E4\uB9AC\uB85C \uB6F4\uB2E4. \uB204\uAD6C\uB098 \uC7A1\uC744 \uC218 \uC788\uC9C0\uB9CC \uC218\uAC00 \uB9CE\uC73C\uBA74 \uC190\uC774 \uBAA8\uC790\uB780\uB2E4."
  illustration: {fileID: -5237074582503671387, guid: 30e9061326d6f2545b20da5c3e7b1a4e, type: 3}
  illustrationTint: {r: 0.92, g: 0.9, b: 0.85, a: 1}
  evidenceName: "\uD1A0\uB07C \uBFD4"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.92, g: 0.9, b: 0.85, a: 1}
  clues:
  - "\uC591\uBC30\uCD94 \uC78E\uC774 \uC2F9 \uAC09\uC544 \uBA39\uD614\uC5B4\uC694. \uC904\uAE30\uB9CC \uB0A8\uC558\uC5B4\uC694."
  - "\uD558\uC580 \uAC8C \uAE61\uCDA9\uAE61\uCDA9 \uB6F0\uC5B4\uAC00\uB294\uB370, \uC774\uB9C8\uC5D0 \uBB54\uAC00 \uBFB0\uC871\uD55C \uAC8C \uC788\uC5C8\uC5B4\uC694."
  - "\uC6B8\uD0C0\uB9AC \uBC11\uC5D0 \uAD74\uC774 \uC5EC\uB7EC \uAC1C \uD30C\uC5EC \uC788\uC5B4\uC694. \uC950\uAD6C\uBA4D\uBCF4\uB2E4 \uCEE4\uC694."
  - "\uAC1C\uAC00 \uCAD3\uC544\uAC14\uB2E4\uAC00 \uCF54\uB97C \uCC14\uB824\uC11C \uB3CC\uC544\uC654\uC5B4\uC694."
