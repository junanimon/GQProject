  m_Script: {fileID: 11500000, guid: c57b41b3327e386449c31e460b304f2c, type: 3}
  m_Name: lizardman
  m_EditorClassIdentifier: Assembly-CSharp::GuildProto.MonsterData
  id: lizardman
  displayName: "\uB9AC\uC790\uB4DC\uB9E8"
  talkName: "\uB9AC\uC790\uB4DC\uB9E8"
  features: "\uB450 \uBC1C\uB85C \uAC77\uB294 \uB3C4\uB9C8\uBC40 \uC804\uC0AC. \uCC3D\uACFC \uBC29\uD328\uB97C \uB4E4\uACE0 \uBB34\uB9AC \uC9C0\uC5B4 \uB2E4\uB2C8\uBA70, \uC11C\uB85C \uC26D\uC26D\uAC70\uB9AC\uB294 \uB9D0\uB85C \uBD80\uB978\uB2E4. \uBB3C\uAC00 \uB9C8\uC744\uC758 \uADF8\uBB3C\uACFC \uC0DD\uC120\uC744 \uD134\uB2E4. \uBC29\uD328 \uBCBD\uC744 \uBC00\uC5B4\uB0BC \uC804\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uC545\uC5B4\uC640 \uB2EC\uB9AC \uB450 \uBC1C \uBC1C\uC790\uAD6D\uACFC \uCC3D \uC790\uAD6D\uC774 \uB0A8\uB294\uB2E4."
  illustration: {fileID: 3574354140817508323, guid: c63eded1a3c3f23448e6520d659512bd, type: 3}
  illustrationTint: {r: 0.36, g: 0.56, b: 0.36, a: 1}
  evidenceName: "\uB9AC\uC790\uB4DC\uB9E8 \uBE44\uB298"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.36, g: 0.56, b: 0.36, a: 1}
  clues:
  - "\uCC3D\uC744 \uB4E0 \uB3C4\uB9C8\uBC40\uB4E4\uC774 \uC904\uC9C0\uC5B4 \uAC08\uB300\uBC2D\uC744 \uC9C0\uB098\uAC14\uC5B4\uC694. \uB450 \uBC1C\uB85C\uC694!"
  - "\uC26D\uC26D, \uC11C\uB85C \uB9D0\uD558\uB294 \uAC83 \uAC19\uC740 \uC18C\uB9AC\uAC00 \uC548\uAC1C \uC18D\uC5D0\uC11C \uB4E4\uB824\uC694."
  - "\uB9D0\uB824 \uB454 \uC0DD\uC120\uC774\uB791 \uADF8\uBB3C\uC774 \uD1B5\uC9F8\uB85C \uC5C6\uC5B4\uC84C\uC5B4\uC694. \uC9C4\uD759\uC5D0 \uCC3D\uB05D \uC790\uAD6D\uC774 \uCC0D\uD600 \uC788\uACE0\uC694."
  - "\uCD08\uB85D \uBE44\uB298 \uD55C \uC7A5\uC774 \uB5A8\uC5B4\uC838 \uC788\uC5C8\uC5B4\uC694. \uC190\uBC14\uB2E5\uB9CC \uD574\uC694."
  questTitles:
  - "\uCC3D\uC744 \uB4E0 \uB3C4\uB9C8\uBC40\uB4E4"
  - "\uADF8\uBB3C\uACFC \uC0DD\uC120\uC774 \uC0AC\uB77C\uC84C\uC5B4\uC694"
  - "\uC548\uAC1C \uC18D \uC26D\uC26D \uC18C\uB9AC"
  countTrace: "\uB450 \uBC1C\uB85C \uAC78\uC740 \uBC1C\uD1B1 \uC790\uAD6D\uC774 {n}\uC30D \uCC0D\uD600 \uC788\uC5C8\uB2E4"
  rankByBand: 010000000200000002000000i
  role: 1
  isMonster: 1
