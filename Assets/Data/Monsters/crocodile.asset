  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.3, g: 0.4, b: 0.26, a: 1}
  clues:
  - "\uBB3C\uC5D0 \uB5A0 \uC788\uB294 \uD1B5\uB098\uBB34\uC778 \uC904 \uC54C\uC558\uB294\uB370 \uB208\uC774 \uC788\uC5C8\uC5B4\uC694."
  - "\uBB3C \uB9C8\uC2DC\uB7EC \uAC04 \uC1A1\uC544\uC9C0\uAC00 \uC21C\uC2DD\uAC04\uC5D0 \uBB3C\uC18D\uC73C\uB85C \uB04C\uB824 \uB4E4\uC5B4\uAC14\uC5B4\uC694."
  - "\uC9C4\uD759 \uB451\uC5D0 \uB124 \uBC1C \uC790\uAD6D\uC774\uB791 \uAD75\uC740 \uAF2C\uB9AC \uB048 \uC790\uAD6D\uC774 \uC788\uC5B4\uC694."
