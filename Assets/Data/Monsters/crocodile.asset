  id: crocodile
  displayName: "\uB2AA \uC545\uC5B4"
  talkName: "\uC545\uC5B4"
  features: "\uD1B5\uB098\uBB34\uCC98\uB7FC \uBB3C\uC5D0 \uB5A0 \uC788\uB2E4\uAC00 \uBB3C\uAC00\uC5D0 \uC628 \uAC83\uC744 \uB04C\uACE0 \uB4E4\uC5B4\uAC04\uB2E4. \uB124 \uBC1C\uB85C \uAE30\uACE0 \uAF2C\uB9AC \uB048 \uC790\uAD6D\uC774 \uB0A8\uB294\uB2E4. \uBB3C\uC18D\uC5D0\uC120 \uB2F9\uD574 \uB0BC \uC218 \uC5C6\uC5B4 \uBB3C \uBC16\uC5D0\uC11C \uD65C\uB85C \uC3D8\uC544\uC57C \uD55C\uB2E4. \uB9AC\uC790\uB4DC\uB9E8\uCC98\uB7FC \uBB34\uAE30\uB97C \uC4F0\uAC70\uB098 \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4."
  illustration: {fileID: 6625497298562620416, guid: cc6370c13fc45d74ea0d0d3a39b07721, type: 3}
  illustrationTint: {r: 0.3, g: 0.4, b: 0.26, a: 1}
