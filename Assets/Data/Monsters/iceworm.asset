  id: iceworm
  displayName: "\uC5BC\uC74C \uC6DC"
  talkName: "\uC5BC\uC74C \uC6DC"
  features: "\uBE59\uD558 \uC18D\uC744 \uD30C\uACE0 \uB2E4\uB2C8\uB294 \uAC70\uB300\uD55C \uD770 \uBC8C\uB808. \uC5BC\uC74C\uC744 \uB179\uC774\uBA70 \uAD74\uC744 \uD30C\uACE0, \uBC1C\uBC11 \uC5BC\uC74C\uC744 \uAE68\uACE0 \uC19F\uC544\uC624\uB978\uB2E4. \uBAB8\uC774 \uCC28\uAC00\uC6CC \uB2FF\uC73C\uBA74 \uB3D9\uC0C1\uC5D0 \uAC78\uB9B0\uB2E4. \uC55E\uC5D0\uC11C \uB9C9\uC544 \uC904 \uC804\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uAD11\uC11D \uBC8C\uB808\uC640 \uB2EC\uB9AC \uB3CC\uC774 \uC544\uB2C8\uB77C \uC5BC\uC74C\uC744 \uD30C\uACE0, \uAD74 \uBCBD\uC774 \uB9E4\uB048\uD558\uAC8C \uC5BC\uC5B4 \uC788\uB2E4."
  illustration: {fileID: 4569161321755363472, guid: 771817a0c32124041ab0c30c861ef3b3, type: 3}
  illustrationTint: {r: 0.76, g: 0.86, b: 0.96, a: 1}
  evidenceName: "\uC5BC\uC74C \uC6DC \uC774\uBE68"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.76, g: 0.86, b: 0.96, a: 1}
  clues:
  - "\uBE59\uD310 \uBC11\uC5D0\uC11C \uBB54\uAC00 \uAE34 \uAC8C \uC9C0\uB098\uAC00\uB294 \uADF8\uB9BC\uC790\uAC00 \uBCF4\uC600\uC5B4\uC694."
  - "\uC5BC\uC74C\uC774 \uCA4D \uAC08\uB77C\uC9C0\uB354\uB2C8 \uD558\uC580 \uAC8C \uC19F\uC558\uB2E4\uAC00 \uB2E4\uC2DC \uB4E4\uC5B4\uAC14\uC5B4\uC694."
  - "\uBE59\uD558\uC5D0 \uC0AC\uB78C\uC774 \uC11C\uC11C \uB4E4\uC5B4\uAC08 \uB9CC\uD55C \uAD74\uC774 \uB9E4\uB048\uD558\uAC8C \uB6AB\uB824 \uC788\uC5B4\uC694."
  - "\uADF8 \uADFC\uCC98\uC5D0 \uC788\uB358 \uC0AC\uB78C\uC774 \uC190\uAC00\uB77D\uC5D0 \uB3D9\uC0C1\uC744 \uC785\uC5C8\uC5B4\uC694."
