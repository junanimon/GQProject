  - "\uCC3D\uACE0\uB85C \uB4E4\uC5B4\uAC00\uB294 \uBD89\uC740 \uD589\uB82C"
  - "\uC300\uAC00\uB9C8\uB2C8\uAC00 \uBE44\uC5B4\uC694"
