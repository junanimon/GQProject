  displayName: "\uAC70\uB300 \uB450\uAEBC\uBE44"
  talkName: "\uAC70\uB300 \uB450\uAEBC\uBE44"
  features: "\uAC08\uC0C9\uC5D0 \uC6B8\uD241\uBD88\uD241\uD55C \uD53C\uBD80, \uC0AC\uB78C \uD0A4\uB9CC \uD558\uB2E4. '\uC6B0\uC6C5' \uD558\uB294 \uB0AE\uC740 \uC6B8\uC74C. \uAC00\uCD95\uC744 \uD1B5\uC9F8\uB85C \uC0BC\uD0A8\uB2E4. \uB048\uC801\uD55C \uC810\uC561 \uB54C\uBB38\uC5D0 \uCE7C\uB0A0\uC774 \uBBF8\uB044\uB7EC\uC9C4\uB2E4."
