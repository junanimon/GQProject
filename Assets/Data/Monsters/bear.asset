  id: bear
  displayName: "\uD751\uACF0"
  talkName: "\uD751\uACF0"
  features: "\uAC80\uC740 \uD138\uC758 \uD070 \uACF0. \uB0AE\uC5D0 \uB3CC\uC544\uB2E4\uB2C8\uBA70 \uBC8C\uD1B5\uACFC \uACFC\uC2E4\uB098\uBB34\uB97C \uD134\uB2E4. \uB098\uBB34\uC5D0 \uB4F1\uC744 \uBE44\uBE44\uACE0 \uBC1C\uD1B1 \uC790\uAD6D\uC744 \uB192\uAC8C \uB0A8\uAE34\uB2E4. \uC6B8\uC74C\uC18C\uB9AC\uB294 \uB0AE\uACE0 \uAD75\uB2E4. \uD798\uC73C\uB85C \uBC84\uD168 \uC904 \uC804\uC0AC\uAC00 \uC788\uC5B4\uC57C \uD55C\uB2E4. \uAE43\uD138\uC740 \uC5C6\uB2E4."
  illustration: {fileID: -6348806237195144154, guid: 067e51a8bb56c0c489f21efed41c66b2, type: 3}
  illustrationTint: {r: 0.22, g: 0.2, b: 0.2, a: 1}
  evidenceName: "\uACF0 \uBC1C\uD1B1"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.22, g: 0.2, b: 0.2, a: 1}
  clues:
  - "\uBC8C\uD1B5\uC774 \uD1B5\uC9F8\uB85C \uC4F0\uB7EC\uC838 \uAFC0\uC774 \uB2E4 \uC5C6\uC5B4\uC84C\uC5B4\uC694. \uB300\uB0AE\uC5D0\uC694!"
  - "\uC0AC\uACFC\uB098\uBB34 \uAC00\uC9C0\uAC00 \uBD80\uB7EC\uC9C0\uACE0, \uB098\uBB34\uAECD\uC9C8\uC5D0 \uC0AC\uB78C \uD0A4\uBCF4\uB2E4 \uB192\uC774 \uAE01\uD78C \uC790\uAD6D\uC774 \uC788\uC5B4\uC694."
  - "\uB0AE\uAC8C \uC6B0\uB974\uB989 \uD558\uB294 \uC18C\uB9AC\uB97C \uB4E4\uC5C8\uC5B4\uC694. \uAE4C\uB9CC \uD138\uC774 \uAC00\uC2DC\uB364\uBD88\uC5D0 \uAC78\uB824 \uC788\uC5C8\uACE0\uC694."
  - "\uBC1C\uBC14\uB2E5 \uC790\uAD6D\uC774 \uC81C \uC5BC\uAD74\uB9CC \uD574\uC694. \uBC1C\uAC00\uB77D \uB05D\uC5D0 \uAE34 \uBC1C\uD1B1 \uC790\uAD6D\uB3C4 \uC788\uC5B4\uC694."
  questTitles:
  - "\uBC8C\uD1B5\uC774 \uD138\uB838\uC5B4\uC694"
  - "\uACFC\uC218\uC6D0\uC758 \uAC80\uC740 \uADF8\uB9BC\uC790"
  - "\uB300\uB0AE\uC758 \uD070 \uBC1C\uC790\uAD6D"
  countTrace: "\uC9C4\uD759\uC5D0 \uD070 \uBC1C\uBC14\uB2E5 \uC790\uAD6D\uC774 {n}\uC30D \uCC0D\uD600 \uC788\uC5C8\uB2E4"
