  id: polarbear
  displayName: "\uBC31\uACF0"
  talkName: "\uBC31\uACF0"
  features: "\uB208\uCC98\uB7FC \uD770 \uD070 \uACF0. \uC5BC\uC74C \uD638\uC218\uC5D0\uC11C \uBB3C\uACE0\uAE30\uB97C \uC7A1\uACE0, \uBC30\uACE0\uD504\uBA74 \uCD08\uC18C \uC2DD\uB7C9 \uCC3D\uACE0\uB97C \uBD80\uC21C\uB2E4. \uB124 \uBC1C\uB85C \uB2E4\uB2C8\uB2E4 \uC77C\uC5B4\uC120\uB2E4. \uD798\uC73C\uB85C \uBC84\uD168 \uC904 \uC804\uC0AC\uAC00 \uD544\uC694\uD558\uB2E4. \uC608\uD2F0\uC640 \uB2EC\uB9AC \uB124 \uBC1C \uC790\uAD6D\uC774 \uB300\uBD80\uBD84\uC774\uACE0 \uBB3C\uAC74\uC744 \uB358\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
