  illustrationTint: {r: 0.95, g: 0.95, b: 0.92, a: 1}
  evidenceName: "\uBC31\uACF0 \uBC1C\uD1B1"
  evidenceIcon: {fileID: 1729840402284382006, guid: a7c0abfbe180f034f8d095ca8b880eee, type: 3}
  evidenceTint: {r: 0.95, g: 0.95, b: 0.92, a: 1}
  clues:
  - "\uC5BC\uC74C \uD638\uC218 \uAD6C\uBA4D \uC606\uC5D0 \uBB3C\uACE0\uAE30 \uBF08\uAC00 \uC794\uB729 \uC788\uC5B4\uC694."
  - "\uC2DD\uB7C9 \uCC3D\uACE0 \uBB38\uC9DD\uC774 \uB72F\uACA8 \uB098\uAC14\uC5B4\uC694. \uAE01\uD78C \uC790\uAD6D\uC774 \uC5C4\uCCAD \uB113\uC5B4\uC694."
  - "\uD558\uC580 \uACF0\uC774 \uB124 \uBC1C\uB85C \uAC77\uB2E4\uAC00 \uC800\uB97C \uBCF4\uACE0 \uBC8C\uB5A1 \uC77C\uC5B4\uC130\uC5B4\uC694."
  - "\uB208 \uC704 \uBC1C\uC790\uAD6D\uC774 \uD751\uACF0 \uBC1C\uC790\uAD6D\uBCF4\uB2E4 \uD6E8\uC52C \uCEE4\uC694."
