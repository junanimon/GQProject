  displayName: "\uC0B0\uC131 \uC824\uB9AC"
  talkName: "\uC0B0\uC131 \uC824\uB9AC"
  features: "\uAC31\uB3C4 \uBB3C\uC6C5\uB369\uC774\uC5D0 \uC0AC\uB294 \uC5F0\uB450\uC0C9 \uC824\uB9AC. \uB2FF\uC740 \uAC83\uC744 \uB179\uC778\uB2E4. \uACE1\uAD2D\uC774 \uC1E0 \uBD80\uBD84\uC774 \uB179\uC544 \uC788\uC73C\uBA74 \uC774 \uB140\uC11D\uC774\uB2E4. \uC2AC\uB77C\uC784\uBCF4\uB2E4 \uD06C\uACE0 \uB3C5\uD558\uBA70, \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0\uC11C \uC5F0\uAE30\uAC00 \uB09C\uB2E4. \uB9C8\uBC95\uC73C\uB85C \uC99D\uBC1C\uC2DC\uCF1C\uC57C \uD55C\uB2E4."
