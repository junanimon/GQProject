%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41a9f6c163264ade957a3bc985b1bacc, type: 3}
  m_Name: lulu
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uB8E8\uB8E8"
  epithet: "\uC790\uCE6D \uB300\uB9C8\uBC95\uC0AC"
  rank: 0
  job: 3
  look:
    label: "\uB8E8\uB8E8"
    body: {fileID: 2847735569288200382, guid: 6e7a57ce5c7931046ab1e83ac2672ca4, type: 3}
    portrait: {fileID: 6312499188071169308, guid: eee03585005b04d42901da843d183437, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  startAffinity: 50
  level: 3
  profile: "\uD3ED\uBC1C \uB9C8\uBC95 \uD558\uB098\uB9CC \uC4F0\uB294 \uC5F4\uB124 \uC0B4 \uAF2C\uB9C8 \uB9C8\uBC95\uC0AC. \uC785\uB9CC \uC5F4\uBA74 '\uB300\uB9C8\uBC95\uC0AC \uB8E8\uB8E8\uB2D8'. \uBCF4\uC218\uAC00 \uD070 \uC758\uB8B0\uB9CC \uB178\uB9B0\uB2E4."
  secret: "\uB9C8\uC744 \uC678\uACFD \uACE0\uC544\uC6D0 \uCD9C\uC2E0. \uC6D0\uC7A5 \uD560\uBA38\uB2C8\uC758 \uC57D\uAC12\uC744 \uBC8C\uB824\uACE0 \uBB34\uB9AC\uD55C \uC758\uB8B0\uB97C \uACE0\uB978\uB2E4. \uD3ED\uBC1C \uB9C8\uBC95\uB9CC \uC4F0\uB294 \uAC74 \uD559\uBE44\uAC00 \uC5C6\uC5B4 \uB9C8\uBC95 \uD559\uC6D0\uC5D0\uC11C \uD55C \uD559\uAE30 \uB9CC\uC5D0 \uCAD3\uACA8\uB0AC\uAE30 \uB54C\uBB38."
  greed: 0.6
  forgeryTendency: 0.15
  greetings:
  - "\uD6C4\uD6C4\uD6C4, \uB300\uB9C8\uBC95\uC0AC \uB8E8\uB8E8\uB2D8\uC774 \uC624\uB298\uB3C4 \uAC15\uB9BC\uD558\uC168\uB2E4!"
  - "\uC774 \uC758\uB8B0, \uB0B4 \uD3ED\uBC1C \uB9C8\uBC95\uC774\uBA74 \uD55C \uBC29\uC774\uC57C!"
  - "\uBCF4\uC218 \uD070 \uAC78\uB85C \uC918. \u2026\uC544, \uC544\uB2C8 \uADF8\uB0E5 \uC774\uAC70."
  thanks:
  - "\uB2F9\uC5F0\uD558\uC9C0! \uB8E8\uB8E8\uB2D8\uC744 \uB204\uAD6C\uB77C\uACE0 \uC0DD\uAC01\uD558\uB294 \uAC70\uC57C?"
  - "\uAE30\uB2E4\uB824, \uAE08\uBC29 \uD391! \uD558\uACE0 \uC62C \uD14C\uB2C8\uAE4C!"
  rejected:
  - "\uBB50\uC5B4?! \uB300\uB9C8\uBC95\uC0AC\uB97C \uBAB0\uB77C\uBCF4\uB2E4\uB2C8!"
  - "\u2026\uCE58. \uB2E4\uC74C\uC5D4 \uAF2D \uBC1B\uC544\uB0BC \uAC70\uC57C."
  caught:
  - "\uC73C, \uC73C\uC73C\u2026 \uB4F1\uAE09 \uAC19\uC740 \uAC74 \uC22B\uC790\uC77C \uBFD0\uC778\uB370\u2026"
  returnSuccess:
  - "\uD391! \uD55C \uBC29\uC774\uC5C8\uB2E4\uACE0! \u2026\uADFC\uB370 \uC637\uC774 \uC880 \uD0D4\uC5B4."
  - "\uBD24\uC9C0? \uC774\uAC8C \uB300\uB9C8\uBC95\uC0AC\uC758 \uC2E4\uB825\uC774\uC57C!"
  returnFail:
  - "\uB9C8, \uB9C8\uB825\uC774 \uC880 \uBD80\uC871\uD588\uC744 \uBFD0\uC774\uC57C! \uC808\uB300 \uC9C4 \uAC70 \uC544\uB2C8\uC57C!"
  chats:
  - "\uC811\uC218\uC6D0, \uB108 \uD3ED\uBC1C \uB9C8\uBC95 \uC88B\uC544\uD574? \uC548 \uC88B\uC544\uD574? \u2026\uC774\uC0C1\uD55C \uC0AC\uB78C."
  - "\uACE0\uC544\uC6D0 \uD560\uBA38\uB2C8\uAC00 \uC694\uC998 \uAE30\uCE68\uC744 \uD574. \u2026\uC544, \uC544\uBB34\uAC83\uB3C4 \uC544\uB0D0!"
  events:
  - title: "\uB300\uB9C8\uBC95\uC0AC\uC758 \uACC4\uC0B0"
    minAffinity: 55
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uC601\uC5C5\uC774 \uB05D\uB09C \uC800\uB141. \uCC3D\uAD6C \uAD6C\uC11D\uC5D0\uC11C \uB8E8\uB8E8\uAC00 \uB3D9\uC804\uC744 \uC138\uACE0 \uC788\uB2E4."
    - speaker: "\uB8E8\uB8E8"
      text: "\uCE60\uC2ED\u2026 \uCE60\uC2ED\uC624\u2026 \uC73C\uC73C, \uC544\uC9C1 \uBAA8\uC790\uB77C."
    - speaker: "\uB098"
      text: "\uBB50\uAC00 \uBAA8\uC790\uB77C?"
    - speaker: "\uB8E8\uB8E8"
      text: "\uD788\uC775?! \uC5B4, \uC5B8\uC81C\uBD80\uD130 \uAC70\uAE30 \uC788\uC5C8\uC5B4! \u2026\uC544\uBB34\uAC83\uB3C4 \uC544\uB0D0. \uB300\uB9C8\uBC95\uC0AC\uC758 \uC5F0\uAD6C\uBE44\uC57C!"
    - speaker: 
      text: "\uB3D9\uC804 \uC0AC\uC774\uB85C \uC57D\uBC29 \uC601\uC218\uC99D\uC774 \uC090\uC838\uB098\uC640 \uC788\uC5C8\uB2E4. '\uD574\uC5F4\uCD08 \uB2EC\uC784\uC57D \u2014 \uACE0\uC544\uC6D0 \uC55E'."
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\uBCF4\uC9C0 \uB9C8. \uBCF4\uBA74 \uD3ED\uBC1C\uC2DC\uD0AC \uAC70\uC57C. \uC9C4\uC9DC\uB85C."
  - title: "\uD3ED\uBC1C \uB9C8\uBC95\uBC16\uC5D0"
    minAffinity: 70
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uB8E8\uB8E8"
      text: "\uC811\uC218\uC6D0. \uB108, \uB0B4\uAC00 \uC65C \uD3ED\uBC1C \uB9C8\uBC95\uB9CC \uC4F0\uB294\uC9C0 \uC54C\uC544?"
    - speaker: "\uB098"
      text: "\uBA4B\uC788\uC5B4\uC11C?"
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\uADF8\uAC83\uBC16\uC5D0 \uBABB \uBC30\uC6E0\uC73C\uB2C8\uAE4C. \uB9C8\uBC95 \uD559\uC6D0\uC5D0\uC11C \uD55C \uD559\uAE30 \uB9CC\uC5D0 \uCAD3\uACA8\uB0AC\uAC70\uB4E0. \uD559\uBE44\uAC00 \uC5C6\uC5B4\uC11C."
    - speaker: "\uB8E8\uB8E8"
      text: "\uADF8\uB798\uC11C \uD55C \uBC29\uC5D0 \uB05D\uB098\uB294 \uD070 \uC758\uB8B0\uB9CC \uB178\uB9AC\uB294 \uAC70\uC57C. \uBE68\uB9AC, \uB9CE\uC774 \uBC8C\uC5B4\uC57C \uD558\uB2C8\uAE4C."
    - speaker: "\uB098"
      text: "\uADF8\uB798\uB3C4 \uBB34\uB9AC\uD558\uBA74 \uD560\uBA38\uB2C8\uAC00 \uB354 \uAC71\uC815\uD558\uC2E4 \uAC70\uC57C."
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\u2026. \uADF8\uB0E5 '\uB8E8\uB8E8'\uB77C\uACE0 \uBD88\uB7EC. \uB300\uB9C8\uBC95\uC0AC \uB9D0\uACE0. \uB108\uD55C\uD14C\uB294."
  - title: "\uACE0\uC544\uC6D0\uC758 \uC800\uB141"
    minAffinity: 85
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uB8E8\uB8E8\uC5D0\uAC8C \uB04C\uB824 \uB9C8\uC744 \uC678\uACFD\uC758 \uC791\uC740 \uACE0\uC544\uC6D0\uC5D0 \uC654\uB2E4. \uC544\uC774\uB4E4\uC774 \uB8E8\uB8E8\uB97C '\uC5B8\uB2C8'\uB77C \uBD80\uB974\uBA70 \uB9E4\uB2EC\uB9B0\uB2E4."
    - speaker: "\uC6D0\uC7A5 \uD560\uBA38\uB2C8"
      text: "\u2026\uC790\uB124\uAC00 \uADF8 \uC811\uC218\uC6D0\uC774\uAD6C\uBA3C. \uC774 \uC560\uAC00 \uB9E4\uC77C \uC790\uB124 \uC598\uAE30\uB97C \uD574."
    - speaker: "\uB8E8\uB8E8"
      text: "\uD558, \uD560\uBA38\uB2C8! \uADF8\uB7F0 \uB9D0 \uD558\uC9C0 \uB9C8!"
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\uC800\uAE30, \uC811\uC218\uC6D0. \uB098 \uC9C4\uC9DC \uB300\uB9C8\uBC95\uC0AC\uAC00 \uB420 \uAC70\uC57C. \uD3ED\uBC1C \uB9D0\uACE0 \uB2E4\uB978 \uAC83\uB3C4 \uBC30\uC6CC\uC11C."
    - speaker: "\uB8E8\uB8E8"
      text: "\uADF8\uB7EC\uB2C8\uAE4C\u2026 \uADF8\uB54C\uAE4C\uC9C0 \uB0B4 \uC758\uB8B0\uC11C, \uB124\uAC00 \uACE8\uB77C \uC918."
  - title: "\uD560\uBA38\uB2C8\uAC00 \uC4F0\uB7EC\uC9C4 \uB0A0"
    minAffinity: 50
    minWeek: 3
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uBB38\uC744 \uB2EB\uC73C\uB824\uB294\uB370, \uB204\uAC00 \uCC3D\uAD6C \uBB38\uC744 \uCF85\uCF85 \uB450\uB4DC\uB9B0\uB2E4."
    - speaker: "\uB8E8\uB8E8"
      text: "\uC811\uC218\uC6D0! \uBB38 \uC5F4\uC5B4! \uD560\uBA38\uB2C8\uAC00\u2026 \uD560\uBA38\uB2C8\uAC00 \uC4F0\uB7EC\uC84C\uC5B4!"
    - speaker: 
      text: "\uB8E8\uB8E8\uB97C \uB370\uB9AC\uACE0 \uACE0\uC544\uC6D0\uC73C\uB85C \uB2EC\uB824\uAC14\uB2E4. \uBA3C\uC800 \uC640 \uC788\uB358 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB2E4."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC27F. \uAD1C\uCC2E\uC544\uC694, \uB8E8\uB8E8. \uC5F4\uC740 \uB0B4\uB838\uC5B4\uC694. \uC624\uB298 \uBC24\uB9CC \uB118\uAE30\uBA74 \uB3FC\uC694."
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\uC218\uB140 \uC5B8\uB2C8\uAC00 \uC65C \uC5EC\uAE30 \uC788\uC5B4? \uADF8 \uC57D\uBCD1\u2026 \uC57D\uBC29 \uC601\uC218\uC99D\uC5D0 \uC788\uB358 \uAC70\uB791 \uAC19\uC740 \uAC70\uC796\uC544."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "(\uC7A0\uC2DC \uB9D0\uC774 \uC5C6\uB2E4\uAC00) \u2026\uB4E4\uCF30\uB124\uC694. \uC6D0\uC7A5\uB2D8\uC774 \uB8E8\uB8E8\uD55C\uD14C\uB294 \uB9D0\uD558\uC9C0 \uB9D0\uC544 \uB2EC\uB77C\uACE0 \uD558\uC154\uC11C\uC694."
    - speaker: "\uB8E8\uB8E8"
      text: "\uBC14\uBCF4. \uB2E4\uB4E4 \uBC14\uBCF4\uC57C. \u2026\uACE0\uB9C8\uC6CC, \uC5B8\uB2C8. (\uD6CC\uCA4D) \uC811\uC218\uC6D0\uB3C4\u2026 \uB6F0\uC5B4\uC640 \uC918\uC11C."
  - title: "\uD3ED\uBC1C \uB9D0\uACE0"
    minAffinity: 60
    minWeek: 4
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uCC3D\uAD6C \uB4A4\uB730\uC5D0\uC11C \uD3ED\uBC1C\uC74C \uB300\uC2E0 \uC870\uC6A9\uD55C '\uD401' \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    - speaker: "\uB8E8\uB8E8"
      text: "\uBD10, \uBD10! \uC548 \uD130\uC84C\uC5B4! \uC138\uC2E4\uB9AC\uC544 \uC5B8\uB2C8\uD55C\uD14C \uBC30\uC6B4 \uCE58\uC720 \uB9C8\uBC95 \uAE30\uCD08\uC57C."
    - speaker: 
      text: "\uB8E8\uB8E8\uC758 \uC190\uBC14\uB2E5 \uC704\uC5D0\uC11C \uBC18\uB527\uBD88\uB9CC \uD55C \uBE5B\uC774 \uB5A8\uACE0 \uC788\uB2E4."
    - speaker: "\uB8E8\uB8E8"
      text: "\uC804\uC5FC\uBCD1 \uB3C4\uB294 \uB3D9\uC548 \uB098\uB3C4 \uBB54\uAC00 \uD558\uACE0 \uC2F6\uC5C8\uC5B4. \uD130\uB728\uB9AC\uB294 \uAC70 \uB9D0\uACE0."
    - speaker: "\uB8E8\uB8E8"
      text: "\u2026\uC774\uAC74 \uC548 \uD130\uC9C0\uB124. \uC774\uC0C1\uD558\uB2E4. \uAE30\uBD84 \uC88B\uC740\uB370 \uC880 \uD5C8\uC804\uD574."
    - speaker: "\uB8E8\uB8E8"
      text: "\uADF8\uB798\uB3C4 \uB300\uB9C8\uBC95\uC0AC\uB294 \uB458 \uB2E4 \uD560 \uC904 \uC54C\uC544\uC57C \uD558\uB294 \uAC70\uC796\uC544? \uADF8\uCE58?"
