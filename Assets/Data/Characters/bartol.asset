  m_Script: {fileID: 11500000, guid: 41a9f6c163264ade957a3bc985b1bacc, type: 3}
  m_Name: bartol
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uBC14\uB974\uD1A8"
  epithet: "\uC740\uD1F4\uB97C \uC55E\uB454 \uC0AC\uC790"
  rank: 2
  job: 1
  look:
    label: "\uBC14\uB974\uD1A8"
    body: {fileID: -5583089633300299674, guid: 1ae82195ceaa65b4a98d268079895a75, type: 3}
    portrait: {fileID: 7439765957685245900, guid: 93e0f86de37098e47b89b5a07c6defea, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  startAffinity: 50
  level: 3
  profile: "\uC774 \uB9C8\uC744 \uCD5C\uACE0\uCC38 \uAE08\uAE09 \uC804\uC0AC. \uD638\uD0D5\uD55C \uC6C3\uC74C\uACFC \uCEE4\uB2E4\uB780 \uB3C4\uB07C. \uC774\uBC88 \uACC4\uC808\uC774 \uB05D\uB098\uBA74 \uC740\uD1F4\uD574\uC11C \uC5EC\uAD00\uC744 \uCC28\uB9B4 \uACC4\uD68D\uC774\uB2E4."
  secret: "\uAE38\uB4DC\uC7A5 \uADF8\uB77C\uD568\uC758 \uC61B \uD30C\uD2F0\uC6D0. 20\uB144 \uC804 \uB458\uC774\uC11C \uBD81\uCABD \uC232\uC758 '\uC232\uC758 \uC655'\uC744 \uC7A0\uC7AC\uC6E0\uB2E4(\uBD09\uC778). \uC740\uD1F4 \uACC4\uD68D\uC740 \uC0AC\uC2E4 \uBD09\uC778\uC774 \uC57D\uD574\uC9C0\uB294 \uAC78 \uB290\uB07C\uACE0 \uB9C8\uC9C0\uB9C9\uC744 \uC900\uBE44\uD558\uB294 \uAC83. 3\uC8FC\uCC28 \uCCAB \uC8FD\uC74C \uD6C4\uBCF4 \u2014 \uAC00\uC7A5 \uC544\uD508 \uC8FD\uC74C."
  greed: 0.1
  forgeryTendency: 0
  greetings:
  - "\uD558\uD558! \uAF2C\uB9C8 \uC811\uC218\uC6D0, \uC624\uB298\uB3C4 \uC798 \uBC84\uD2F0\uACE0 \uC788\uB098!"
  - "\uC26C\uC6B4 \uAC78\uB85C \uC918. \uC774 \uB098\uC774\uC5D4 \uD5C8\uB9AC\uAC00 \uB9D0\uC774\uC57C."
  - "\uB9E5\uC8FC \uD55C\uC794 \uC5B4\uB54C? \u2026\uB18D\uB2F4\uC774\uB2E4, \uADFC\uBB34 \uC911\uC774\uC9C0."
  thanks:
  - "\uC88B\uC544, \uB9E1\uACA8 \uB46C\uB77C!"
  - "\uD558\uD558, \uAE08\uBC29 \uB2E4\uB140\uC624\uB9C8."
  rejected:
  - "\uD5C8, \uAE50\uAE50\uD558\uAD6C\uBA3C. \uC88B\uC740 \uC811\uC218\uC6D0\uC774\uC57C."
  - "\uADF8\uB798, \uADDC\uC815\uC740 \uADDC\uC815\uC774\uC9C0."
  caught:
  - "\uD558\uD558\u2026 \uB299\uC740\uC774\uB3C4 \uAC00\uB054 \uC695\uC2EC\uC774 \uB09C\uB2E4\uB124."
  returnSuccess:
  - "\uB05D\uB0AC\uB2E4! \uC800\uB141\uC740 \uB0B4\uAC00 \uC3D8\uC9C0!"
  - "\uC774 \uC815\uB3C4\uB294 \uBAB8\uD480\uAE30\uC9C0."
  returnFail:
  - "\u2026\uB098\uB3C4 \uB299\uC5C8\uAD70. \uBBF8\uC548\uD558\uB2E4."
  chats:
  - "\uC740\uD1F4\uD558\uBA74 \uC5EC\uAD00\uC744 \uCC28\uB9B4 \uAC70\uB2E4. \uC774\uB984\uC740\u2026 '\uC878\uB9B0 \uC0AC\uC790' \uC5B4\uB5A0\uB0D0?"
  - "\uADF8\uB77C\uD568 \uB140\uC11D\uC740 \uC798 \uC9C0\uB0B4\uB098? \uC694\uC998 \uC5BC\uAD74\uC744 \uBABB \uBD24\uAD70."
  events:
  - title: "\uC878\uB9B0 \uC0AC\uC790"
    minAffinity: 55
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAF2C\uB9C8 \uC811\uC218\uC6D0, \uC740\uD1F4\uD558\uBA74 \uBB58 \uD560\uC9C0 \uB4E4\uC5B4 \uBCFC \uD150\uAC00?"
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC5EC\uAD00\uC774\uB2E4! \uC774\uB984\uC740 '\uC878\uB9B0 \uC0AC\uC790'. 1\uCE35\uC740 \uC220\uC9D1, 2\uCE35\uC740 \uC2E0\uC785 \uBAA8\uD5D8\uAC00\uB97C \uC2F8\uAC8C \uC7AC\uC6CC \uC8FC\uB294 \uBC29."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uB0B4\uAC00 \uC2E0\uC785\uC77C \uB54C \uADF8\uB7F0 \uB370\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uC558\uAC70\uB4E0. \uD558\uD558!"
    - speaker: "\uB098"
      text: "\uCCAB \uC190\uB2D8\uC740 \uC81C\uAC00 \uC608\uC57D\uD574 \uB458\uAC8C\uC694."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC88B\uC9C0! \uC811\uC218\uC6D0 \uD560\uC778\uB3C4 \uD574 \uC8FC\uB9C8."
  - title: "\uADF8\uB77C\uD568\uACFC \uB098"
    minAffinity: 70
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAE38\uB4DC\uC7A5 \uADF8\uB77C\uD568 \uC54C\uC9C0? \uADF8 \uB140\uC11D\uC774\uB791 \uB098, \uC61B\uB0A0\uC5D0 \uD55C \uD30C\uD2F0\uC600\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC2A4\uBB34 \uD574 \uC804\uC5D0 \uBD81\uCABD \uC232\uC5D0\uC11C\u2026 '\uBB54\uAC00'\uB97C \uBD24\uB2E4. \uB458\uC774\uC11C \uACA8\uC6B0 \uC7A0\uC7AC\uC6E0\uC9C0. \uBD09\uC778\uC774\uB77C\uACE0 \uD574\uC57C \uD558\uB098."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC694\uC998 \uB291\uB300\uB4E4\uC774 \uB0B4\uB824\uC624\uB294 \uAC78 \uBCF4\uBA74\u2026 \uD5C8\uB9AC\uAC00 \uC544\uB2C8\uB77C \uADF8\uB54C \uB2E4\uCE5C \uC5B4\uAE68\uAC00 \uC464\uC154."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uD558\uD558, \uB299\uC740\uC774 \uD5DB\uC18C\uB9AC\uB2E4. \uC78A\uC5B4\uB77C."
  - title: "\uB9CC\uC57D\uC5D0"
    minAffinity: 85
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAF2C\uB9C8. \uD558\uB098 \uBD80\uD0C1\uD574\uB3C4 \uB418\uACA0\uB098."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uB9CC\uC57D \uB0B4\uAC00 \uC5B4\uB5A4 \uC758\uB8B0\uC5D0\uC11C \uBABB \uB3CC\uC544\uC624\uBA74\u2026 \uC5EC\uAD00 \uC790\uAE08\uC740 \uC62C\uB9AC\uBC84 \uB140\uC11D\uD55C\uD14C \uC918\uB77C. \uADF8 \uB140\uC11D \uD615\uC774 \uB0B4 \uD6C4\uBC30\uC600\uB2E4."
    - speaker: "\uB098"
      text: "\uADF8\uB7F0 \uBD80\uD0C1\uC740 \uC548 \uBC1B\uC544\uC694. \uC740\uD1F4\uD558\uACE0 \uC5EC\uAD00 \uCC28\uB9AC\uC138\uC694. \uCCAB \uC190\uB2D8 \uC608\uC57D\uD588\uC796\uC544\uC694."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\u2026\u2026\uD558\uD558. \uADF8\uB798, \uADF8\uB7AC\uC9C0. \uC88B\uC740 \uC811\uC218\uC6D0\uC774\uC57C, \uB108\uB294."
    - speaker: 
      text: "\uADF8\uB294 \uC6C3\uC5C8\uC9C0\uB9CC, \uB3C4\uB07C\uB97C \uC954 \uC190\uC740 \uC624\uB798 \uD480\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
  - title: "\uB5BC\uC5B4 \uB0B8 \uC758\uB8B0\uC11C"
    minAffinity: 50
    minWeek: 2
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uBC24, \uAC8C\uC2DC\uD310 \uC55E. \uCEE4\uB2E4\uB780 \uADF8\uB9BC\uC790\uAC00 \uC758\uB8B0\uC11C \uD55C \uC7A5\uC744 \uC870\uC6A9\uD788 \uB5BC\uC5B4 \uB0B8\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uD5DB\u2026 \uB4E4\uCF30\uB098. \uD558\uD558, \uC774 \uB299\uC740\uC774\uAC00 \uB208\uCE58\uAC00 \uC5C6\uC5B4\uC11C."
    - speaker: 
      text: "\uB5BC\uC5B4 \uB0B8 \uC758\uB8B0\uC11C\uC5D0\uB294 '\uBD81\uCABD \uC232 \uC870\uC0AC'\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uC774\uAC74 \uC560\uC1A1\uC774\uB4E4\uC774 \uBC1B\uC744 \uAC8C \uC544\uB2C8\uC57C. \uC232\uC774 \uC694\uC998 \uC774\uC0C1\uD558\uAC70\uB4E0."
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uB0B4\uAC00 \uB530\uB85C \uCC98\uB9AC\uD558\uB9C8. \uC11C\uB958\uB294\u2026 \uB124\uAC00 \uBABB \uBCF8 \uAC78\uB85C \uD574 \uC8FC\uACA0\uB098?"
    - speaker: "\uBC14\uB974\uD1A8"
      text: "\uAC71\uC815 \uB9C8\uB77C. \uC5EC\uAD00 \uCC28\uB9AC\uAE30 \uC804\uC5D0 \uC8FD\uC744 \uC0DD\uAC01\uC740 \uC5C6\uC73C\uB2C8."
