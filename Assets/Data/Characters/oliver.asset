  m_Script: {fileID: 11500000, guid: 41a9f6c163264ade957a3bc985b1bacc, type: 3}
  m_Name: oliver
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uC62C\uB9AC\uBC84"
  epithet: "\uC624\uB298 \uB9C9 \uB4F1\uB85D\uD55C \uC2E0\uC785"
  rank: 0
  job: 1
  look:
    label: "\uC62C\uB9AC\uBC84"
    body: {fileID: 113569547703748414, guid: 6cb8f6da98b12cf4b981d2209f0c4ae9, type: 3}
    portrait: {fileID: -1035737903484223299, guid: a3be46dce28d212408b4791303a82885, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  startAffinity: 55
  level: 3
  profile: "\uC811\uC218\uC6D0\uACFC \uAC19\uC740 \uB0A0 \uAE38\uB4DC\uC5D0 \uB4F1\uB85D\uD55C \uC5F4\uC5EC\uC12F \uC0B4 \uC2E0\uC785 \uC804\uC0AC. \uC758\uC695\uC740 \uB204\uAD6C\uBCF4\uB2E4 \uB118\uCE58\uC9C0\uB9CC \uC2E4\uB825\uC740 \uC544\uC9C1."
  secret: "\uD615 \uC5D0\uB4DC\uAC70(\uC740\uAE09 \uC804\uC0AC)\uAC00 3\uB144 \uC804 \uBD81\uCABD \uC232 \uC870\uC0AC \uC758\uB8B0\uC5D0\uC11C \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4. \uD615\uC758 \uB0A1\uC740 \uAC80\uC744 \uC4F4\uB2E4. \uC601\uC6C5\uC774 \uB418\uACE0 \uC2F6\uC740 \uAC8C \uC544\uB2C8\uB77C \uD615\uC774 \uC5B4\uB514\uC11C \uBA48\uCDC4\uB294\uC9C0 \uC54C\uACE0 \uC2F6\uB2E4."
  greed: 0.3
  forgeryTendency: 0
  greetings:
  - "\uC548\uB155\uD558\uC138\uC694 \uC120\uBC30! \u2026\uC544, \uC6B0\uB9AC \uB3D9\uAE30\uC8E0 \uCC38!"
  - "\uC624\uB298\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  - "\uC774\uAC70 \uD574\uB3C4 \uB420\uAE4C\uC694? \uD574\uB3C4 \uB418\uC8E0?!"
  thanks:
  - "\uAC10\uC0AC\uD569\uB2C8\uB2E4! \uAF2D \uD574\uB0BC\uAC8C\uC694!"
  - "\uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4!!"
  rejected:
  - "\uC544\u2026 \uB124! \uB2E4\uC74C\uC5D4 \uB354 \uACF5\uBD80\uD574 \uC62C\uAC8C\uC694!"
  - "\uC5ED\uC2DC \uC544\uC9C1 \uBB34\uB9AC\uC778\uAC00\u2026"
  caught:
  - "\uC8C4, \uC8C4\uC1A1\uD569\uB2C8\uB2E4! \uADDC\uC815 \uB2E4\uC2DC \uC77D\uC5B4 \uC62C\uAC8C\uC694!"
  returnSuccess:
  - "\uD574\uB0C8\uC5B4\uC694! \uC800 \uD574\uB0C8\uC5B4\uC694!"
  - "\uC880 \uAE01\uD614\uC9C0\uB9CC\u2026 \uAD1C\uCC2E\uC544\uC694! \uC774 \uC815\uB3C4\uB294!"
  returnFail:
  - "\u2026\uC8C4\uC1A1\uD574\uC694. \uD615\uC774\uB77C\uBA74 \uD574\uB0C8\uC744 \uD150\uB370."
  chats:
  - "\uC6B0\uB9AC \uB3D9\uAE30\uB07C\uB9AC \uD798\uB0B4\uC694!"
  - "\uC774 \uAC80, \uD615 \uAC70\uC608\uC694. \uC880 \uBB34\uAC81\uC9C0\uB9CC\uC694."
  events:
  - title: "\uB3D9\uAE30"
    minAffinity: 55
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC120\uBC30! \u2026\uC544 \uCC38, \uB3D9\uAE30\uC9C0. \uC6B0\uB9AC \uAC19\uC740 \uB0A0 \uB4E4\uC5B4\uC654\uC796\uC544\uC694!"
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC800\uB294 \uBAA8\uD5D8\uAC00 \uB4F1\uB85D, \uC120\uBC30\uB294 \uC811\uC218\uC6D0 \uB4F1\uB85D. \uBB54\uAC00 \uC6B4\uBA85 \uAC19\uC9C0 \uC54A\uC544\uC694?"
    - speaker: "\uB098"
      text: "\uC6B4\uBA85\uCE58\uACE0\uB294 \uC11C\uB958\uAC00 \uB108\uBB34 \uB9CE\uC740\uB370."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uD558\uD558! \uADF8\uB7EC\uB2C8\uAE4C \uB3D9\uAE30\uB07C\uB9AC \uD798\uB0B4\uC694. \uC81C\uAC00 \uAE08\uAE09 \uB418\uBA74, \uCCAB \uC758\uB8B0\uB294 \uAF2D \uC120\uBC30 \uCC3D\uAD6C\uC5D0\uC11C \uBC1B\uC744\uAC8C\uC694!"
  - title: "\uD615\uC758 \uAC80"
    minAffinity: 70
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uC62C\uB9AC\uBC84\uAC00 \uB0A0\uC774 \uC774 \uBE60\uC9C4 \uB0A1\uC740 \uAC80\uC744 \uB2E6\uACE0 \uC788\uC5C8\uB2E4."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uD615 \uAC70\uC608\uC694. \uC740\uAE09 \uC804\uC0AC\uC600\uC5B4\uC694. \uC0BC \uB144 \uC804\uC5D0 \uC758\uB8B0 \uB098\uAC14\uB2E4\uAC00 \uC548 \uB3CC\uC544\uC654\uC5B4\uC694."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC601\uC6C5\uC774 \uB418\uACE0 \uC2F6\uC740 \uAC74 \uC544\uB2C8\uC5D0\uC694. \uADF8\uB0E5\u2026 \uD615\uC774 \uC5B4\uB514\uC11C \uBA48\uCDC4\uB294\uC9C0, \uADF8\uAC78 \uC54C\uACE0 \uC2F6\uC5B4\uC694."
    - speaker: "\uB098"
      text: "\uAE38\uB4DC \uAE30\uB85D\uC2E4\uC5D0 \uC61B \uC758\uB8B0\uC11C\uAC00 \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C. \uCC3E\uC544\uBCFC\uAC8C."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\u2026\uC815\uB9D0\uC694? \uACE0\uB9C8\uC6CC\uC694, \uB3D9\uAE30."
  - title: "\uD615\uC758 \uB9C8\uC9C0\uB9C9 \uC758\uB8B0\uC11C"
    minAffinity: 85
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uAE30\uB85D\uC2E4 \uBA3C\uC9C0 \uC18D\uC5D0\uC11C \uC0BC \uB144 \uC804 \uC758\uB8B0\uC11C\uB97C \uCC3E\uC558\uB2E4. \uC218\uC8FC\uC790: \uC5D0\uB4DC\uAC70(\uC740\uAE09 \uC804\uC0AC). \uACB0\uACFC \uCE78\uC740 \uBE44\uC5B4 \uC788\uB2E4."
    - speaker: 
      text: "\uC9C0\uC5ED: \uBD81\uCABD \uC232 \uAE4A\uC740 \uACF3. \uC758\uB8B0 \uB0B4\uC6A9: '\uC232\uC758 \uC655\uC744 \uBD24\uB2E4\uB294 \uB098\uBB34\uAFBC\uC758 \uC2E0\uACE0 \uC870\uC0AC'."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\u2026\u2026\uC232\uC758 \uC655."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC120\uBC30. \uC800 \uB354 \uAC15\uD574\uC9C8\uAC8C\uC694. \uC5B8\uC820\uAC00 \uC774 \uACB0\uACFC \uCE78, \uC81C\uAC00 \uCC44\uC6B8 \uAC70\uC608\uC694."
  - title: "\uC740\uAE09\uC758 \uC870\uAC74"
    minAffinity: 50
    minWeek: 2
    stopsForgery: 0
    lines:
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC120\uBC30! \uC2B9\uAE09 \uC2EC\uC0AC\uB294 \uC5B4\uB5BB\uAC8C \uD1B5\uACFC\uD574\uC694? \uC800\uB3C4 \uBE68\uB9AC \uC740\uAE09 \uB418\uACE0 \uC2F6\uC5B4\uC694!"
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uB808\uBCA8\uD558\uACE0 \uC644\uB8CC \uC2E4\uC801, \uB458 \uB2E4 \uCC44\uC6CC\uC57C \uD574. \uD558\uB098\uB9CC \uCC44\uC6B0\uACE0 \uC624\uB294 \uC560\uB4E4\uC774 \uC81C\uC77C \uC704\uD5D8\uD558\uC9C0."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uB458 \uB2E4\uC694? \uB808\uBCA8\uC740 \uC880 \uC62C\uB790\uB294\uB370\u2026 \uC2E4\uC801\uC774 \uC544\uC9C1\u2026"
    - speaker: "\uB9C8\uB974\uD0C0"
      text: "\uAE09\uD560 \uAC70 \uC5C6\uC5B4. \uB4F1\uAE09\uB9CC \uC624\uB974\uACE0 \uC2E4\uB825\uC774 \uC548 \uB530\uB77C\uAC00\uBA74, \uC232\uC774 \uBA3C\uC800 \uC54C\uC544\uBCF4\uAC70\uB4E0."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\u2026\uD615\uB3C4 \uADF8\uB807\uAC8C \uB9D0\uD588\uC5C8\uC5B4\uC694. '\uCE74\uB4DC\uAC00 \uB110 \uC9C0\uCF1C \uC8FC\uC9C4 \uC54A\uC544.'"
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uC120\uBC30, \uC81C\uAC00 \uAE30\uC900\uC744 \uB2E4 \uCC44\uC6B0\uBA74 \uADF8\uB54C \uB3C4\uC7A5 \uCC0D\uC5B4 \uC8FC\uC138\uC694. \uBD10\uC8FC\uAE30 \uC5C6\uC774\uC694!"
