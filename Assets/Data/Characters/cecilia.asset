  m_Script: {fileID: 11500000, guid: 41a9f6c163264ade957a3bc985b1bacc, type: 3}
  m_Name: cecilia
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uC138\uC2E4\uB9AC\uC544"
  epithet: "\uBBF8\uC18C\uC758 \uC218\uB140"
  rank: 1
  job: 4
  look:
    label: "\uC138\uC2E4\uB9AC\uC544"
    body: {fileID: 3846659257892899897, guid: 8c3da2332326cff4a80b9b02cef8e50c, type: 3}
    portrait: {fileID: -1615298968373272274, guid: ca4c5d5ab845715479a6fbb28914f787, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  startAffinity: 55
  profile: "\uB298 \uC6C3\uB294 \uC5BC\uAD74\uC758 \uB5A0\uB3CC\uC774 \uC218\uB140. \uB2E4\uCE5C \uBAA8\uD5D8\uAC00\uB97C \uACF5\uC9DC\uB85C \uCE58\uB8CC\uD574 \uC900\uB2E4. \uAE38\uB4DC\uC758 \uB204\uB098 \uAC19\uC740 \uC874\uC7AC."
  secret: "\uACFC\uAC70 '\uD68C\uC0C9 \uC2EC\uBB38\uAD00'\uC774\uC5C8\uB2E4. \uBA85\uB839\uC73C\uB85C \uD55C \uB9C8\uC744\uC744 \uBD88\uD0DC\uC6B4 \uBC24\uC744 \uC18D\uC8C4\uD558\uBA70 \uB5A0\uB3C8\uB2E4. \uADF8\uB798\uC11C \uCE58\uB8CC\uC640 \uD574\uB3C5\uB9CC \uD558\uACE0, \uBD88\uC744 \uBB34\uC11C\uC6CC\uD55C\uB2E4."
  greed: 0
  forgeryTendency: 0
  greetings:
  - "\uC548\uB155\uD558\uC138\uC694, \uC811\uC218\uC6D0\uB2D8. \uC624\uB298\uB3C4 \uC218\uACE0\uAC00 \uB9CE\uC73C\uC138\uC694."
  - "\uB2E4\uCE5C \uBD84\uC740 \uC5C6\uB098\uC694? \uC81C\uAC00 \uBA3C\uC800 \uAC00 \uBCFC\uAC8C\uC694."
  - "\uD6C4\uD6C4, \uC624\uB298\uC740 \uC5B4\uB5A4 \uC778\uC5F0\uC774 \uAE30\uB2E4\uB9B4\uAE4C\uC694."
  thanks:
  - "\uC2E0\uC758 \uAC00\uD638\uAC00 \uD568\uAED8\uD558\uAE38."
  - "\uACE0\uB9C8\uC6CC\uC694. \uC870\uC2EC\uD574\uC11C \uB2E4\uB140\uC62C\uAC8C\uC694."
  rejected:
  - "\uC5B4\uBA38, \uC81C\uAC00 \uBB54\uAC00 \uB193\uCCE4\uB098 \uBCF4\uB124\uC694."
  - "\uAD1C\uCC2E\uC544\uC694. \uADDC\uCE59\uC740 \uC9C0\uCF1C\uC57C\uC8E0."
  caught:
  - "\u2026\uB4E4\uCF1C \uBC84\uB838\uB124\uC694. \uBC18\uC131\uD560\uAC8C\uC694."
  returnSuccess:
  - "\uBAA8\uB450 \uBB34\uC0AC\uD574\uC694. \uADF8\uAC8C \uC81C\uC77C\uC774\uC8E0."
  - "\uC0C1\uCC98\uB294 \uC81C\uAC00 \uB2E4 \uCE58\uB8CC\uD588\uB2F5\uB2C8\uB2E4."
  returnFail:
  - "\u2026\uC81C \uAE30\uB3C4\uAC00 \uBD80\uC871\uD588\uB098 \uBD10\uC694."
  chats:
  - "\uC811\uC218\uC6D0\uB2D8, \uC694\uC998 \uC7A0\uC740 \uC798 \uC790\uC694? \uB208 \uBC11\uC774 \uC5B4\uB450\uC6CC\uC694."
  - "\uBD88\uC744 \uBCF4\uBA74\u2026 \uC544, \uC544\uB2C8\uC5D0\uC694. \uCC28 \uD55C\uC794\uD560\uB798\uC694?"
  events:
  - title: "\uBD88\uC774 \uBB34\uC11C\uC6B4 \uC218\uB140"
    minAffinity: 55
    lines:
    - speaker: 
      text: "\uB09C\uB85C\uC5D0 \uBD88\uC744 \uBD99\uC774\uC790 \uC138\uC2E4\uB9AC\uC544\uAC00 \uC6C0\uCC14\uD558\uBA70 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uB0AC\uB2E4."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC5B4\uBA38, \uBBF8\uC548\uD574\uC694. \uC81C\uAC00 \uBD88\uC744 \uC870\uAE08\u2026 \uBB34\uC11C\uC6CC\uD574\uC11C\uC694."
    - speaker: "\uB098"
      text: "\uC131\uC9C1\uC790\uC778\uB370 \uC815\uD654\uC758 \uBD88\uAF43 \uAC19\uC740 \uAC74 \uC548 \uC368?"
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uD6C4\uD6C4, \uC548 \uC368\uC694. \uCE58\uB8CC\uB791 \uD574\uB3C5\uB9CC. \u2026\uADF8\uAC8C \uC81C\uAC00 \uC2A4\uC2A4\uB85C \uC815\uD55C \uADDC\uCE59\uC774\uC5D0\uC694."
  - title: "\uC61B \uC774\uB984"
    minAffinity: 70
    lines:
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC811\uC218\uC6D0\uB2D8, \uD639\uC2DC '\uD68C\uC0C9 \uC2EC\uBB38\uAD00'\uC774\uB77C\uB294 \uB9D0 \uB4E4\uC5B4 \uBCF8 \uC801 \uC788\uC5B4\uC694?"
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC774\uB2E8\uC744 \uCC3E\uC544 \uD0DC\uC6B0\uB358 \uC0AC\uB78C\uB4E4. \uC800\uB3C4\u2026 \uADF8\uC911 \uD558\uB098\uC600\uC5B4\uC694. \uC774\uB984\uB3C4 \uC9C0\uAE08\uC774\uB791 \uB2EC\uB790\uC8E0."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uBA85\uB839\uB300\uB85C \uD55C \uB9C8\uC744\uC744 \uBD88\uD0DC\uC6B4 \uBC24\uC774 \uC788\uC5B4\uC694. \uADF8 \uB4A4\uB85C \uB5A0\uB3CC\uBA74\uC11C, \uB2E4\uCE5C \uC0AC\uB78C\uC744 \uCE58\uB8CC\uD558\uACE0 \uC788\uC5B4\uC694."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC774\uAC78\uB85C \uAC1A\uC544\uC9C8 \uAC70\uB77C\uACE0\uB294 \uC0DD\uAC01 \uC548 \uD574\uC694. \uADF8\uB798\uB3C4\u2026 \uBA48\uCD94\uBA74 \uC548 \uB420 \uAC83 \uAC19\uC544\uC11C."
  - title: "\uACE0\uD574"
    minAffinity: 85
    lines:
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uC774\uC0C1\uD558\uC8E0. \uC2E0\uBD80\uB2D8\uAED8\uB3C4 \uBABB \uD55C \uC598\uAE30\uB97C \uC811\uC218\uC6D0\uB2D8\uD55C\uD14C\uB294 \uB2E4 \uD588\uC5B4\uC694."
    - speaker: "\uB098"
      text: "\uB09C \uD310\uACB0\uC740 \uBABB \uB0B4\uB824. \uC11C\uB958\uC5D0 \uB3C4\uC7A5\uB9CC \uCC0D\uC744 \uC218 \uC788\uC9C0."
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uD6C4\uD6C4\u2026 \uADF8\uB7FC \uD558\uB098\uB9CC \uCC0D\uC5B4 \uC8FC\uC138\uC694. '\uC138\uC2E4\uB9AC\uC544, \uC624\uB298\uB3C4 \uBB34\uC0AC \uADC0\uD658.'"
    - speaker: "\uC138\uC2E4\uB9AC\uC544"
      text: "\uADF8 \uB3C4\uC7A5\uC774 \uC313\uC774\uBA74, \uC5B8\uC820\uAC00 \uC800\uB3C4 \uC800\uB97C \uC6A9\uC11C\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694."
