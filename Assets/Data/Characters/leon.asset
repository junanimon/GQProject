  m_Script: {fileID: 11500000, guid: 41a9f6c163264ade957a3bc985b1bacc, type: 3}
  m_Name: leon
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uB808\uC628"
  epithet: "\uC7A5\uB798\uC758 \uC601\uC6C5"
  rank: 1
  job: 1
  look:
    label: "\uB808\uC628"
    body: {fileID: -8400704037998170941, guid: 72889f2e927e46c468345459ea1a5a72, type: 3}
    portrait: {fileID: -6581490813268160515, guid: 68f41f9bd889e0f44be4a3533649537b, type: 3}
    tint: {r: 1, g: 1, b: 1, a: 1}
  startAffinity: 45
  profile: "\uC740\uBE5B \uAC11\uC637\uC744 \uBC88\uCA4D\uC774\uB294 \uADC0\uC871 \uAC00\uBB38\uC758 \uC14B\uC9F8 \uC544\uB4E4. \uC790\uAE30 \uBB34\uC6A9\uB2F4\uC744 \uB298\uC5B4\uB193\uB294 \uAC8C \uCDE8\uBBF8."
  secret: "\uAC00\uBB38\uC5D0\uC11C '\uAE08\uAE09\uC774 \uB418\uAE30 \uC804\uC5D4 \uB3CC\uC544\uC624\uC9C0 \uB9C8\uB77C'\uB294 \uD1B5\uBCF4\uB97C \uBC1B\uC558\uB2E4. \uCD08\uC870\uD568\uC5D0 \uAC00\uB054 \uC120\uC744 \uB118\uB294\uB2E4 \u2014 \uC704\uC870 \uCE74\uB4DC\uB97C \uC4F0\uB294 \uC720\uC77C\uD55C \uB124\uC784\uB4DC. \uD638\uAC10\uB3C4\uAC00 \uC624\uB974\uBA74 \uC2A4\uC2A4\uB85C \uC704\uC870\uB97C \uADF8\uB9CC\uB454\uB2E4(\uC774\uBCA4\uD2B8 2)."
  greed: 0.4
  forgeryTendency: 0.5
  greetings:
  - "\uC774 \uB808\uC628 \uD3F0 \uC544\uC2A4\uD14C\uB974\uAC00 \uC654\uB178\uB77C!"
  - "\uD3C9\uBBFC\uB4E4\uC744 \uC704\uD574 \uC624\uB298\uB3C4 \uAC80\uC744 \uB4E4\uC5B4 \uC8FC\uC9C0."
  - "\uD760, \uC774 \uC758\uB8B0\uAC00 \uB0B4 \uACA9\uC5D0 \uB9DE\uACA0\uAD70."
  thanks:
  - "\uC601\uAD11\uC73C\uB85C \uC54C\uB3C4\uB85D!"
  - "\uD6C4, \uC5ED\uC2DC \uBCF4\uB294 \uB208\uC774 \uC788\uAD70."
  rejected:
  - "\uBB63\u2026?! \uC774 \uBAB8\uC744 \uAC70\uC808\uD55C\uB2E4\uACE0?"
  - "\u2026\uAE30\uC5B5\uD574 \uB450\uC9C0."
  caught:
  - "\u2026\u2026\uC544\uBB34\uC5D0\uAC8C\uB3C4 \uB9D0\uD558\uC9C0 \uB9C8\uB77C. \uBD80\uD0C1\uC774\uB2E4."
  returnSuccess:
  - "\uBCF4\uC558\uB294\uAC00, \uC774\uAC83\uC774 \uC544\uC2A4\uD14C\uB974 \uAC00\uC758 \uAC80\uC220\uC774\uB2E4!"
  returnFail:
  - "\u2026\u2026\uC624\uB298 \uC77C\uC740, \uAE30\uB85D\uC5D0 \uB0A8\uAE30\uC9C0 \uB9D0\uC544 \uC8FC\uACA0\uB098."
  chats:
  - "\uAE08\uAE09\uC774 \uB418\uBA74 \uC774 \uB9C8\uC744\uC5D0 \uB0B4 \uB3D9\uC0C1\uC744 \uC138\uC6CC \uC8FC\uC9C0."
  - "\u2026\uAC00\uBB38\uC5D0\uC11C \uD3B8\uC9C0\uAC00 \uC654\uB2E4. \uC77D\uC9C0\uB294 \uC54A\uC558\uB2E4."
  events:
  - title: "\uB72F\uC9C0 \uC54A\uC740 \uD3B8\uC9C0"
    minAffinity: 55
    lines:
    - speaker: "\uB808\uC628"
      text: "\uD760, \uC811\uC218\uC6D0. \uC774 \uD3B8\uC9C0\uB97C \uB300\uC2E0 \uBC84\uB824 \uC8FC\uACA0\uB098."
    - speaker: 
      text: "\uC544\uC2A4\uD14C\uB974 \uAC00\uBB38\uC758 \uBD09\uB78D\uC774 \uCC0D\uD78C \uD3B8\uC9C0\uC600\uB2E4. \uB72F\uC9C0\uB3C4 \uC54A\uC740 \uCC44\uC600\uB2E4."
    - speaker: "\uB098"
      text: "\uC548 \uC77D\uC5B4\uB3C4 \uB3FC?"
    - speaker: "\uB808\uC628"
      text: "\uC77D\uC9C0 \uC54A\uC544\uB3C4 \uC548\uB2E4. '\uAE08\uAE09\uC774 \uB418\uAE30 \uC804\uC5D4 \uB3CC\uC544\uC624\uC9C0 \uB9C8\uB77C.' \uB9E4\uBC88 \uAC19\uC740 \uB0B4\uC6A9\uC774\uB2C8\uAE4C."
    - speaker: "\uB808\uC628"
      text: "\u2026\uC14B\uC9F8 \uC544\uB4E4\uC774\uB780 \uADF8\uB7F0 \uAC70\uB2E4. \uD558\uD558! \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8\uB77C. \uC601\uC6C5\uC5D0\uAC8C \uACE0\uB09C\uC740 \uD544\uC218\uC9C0!"
  - title: "\uC120\uC744 \uB118\uC740 \uBC24"
    minAffinity: 70
    lines:
    - speaker: "\uB808\uC628"
      text: "\u2026\uC811\uC218\uC6D0. \uC194\uC9C1\uD788 \uB9D0\uD558\uC9C0. \uC704\uC870 \uCE74\uB4DC\uB97C \uC4F4 \uC801\uC774 \uC788\uB2E4."
    - speaker: "\uB808\uC628"
      text: "\uC740\uAE09\uC73C\uB85C\uB294 \uAC00\uBB38\uC774 \uC778\uC815\uD560 \uB9CC\uD55C \uC758\uB8B0\uB97C \uBC1B\uC744 \uC218 \uC5C6\uC73C\uB2C8\uAE4C."
    - speaker: "\uB808\uC628"
      text: "\uADF8\uB7F0\uB370 \uB124\uAC00 \uB9E4\uBC88 \uCE74\uB4DC\uB97C \uB6AB\uC5B4\uC838\uB77C \uBCF4\uB294 \uAC78 \uBCF4\uACE0\u2026 \uADF8\uB9CC\uB450\uAE30\uB85C \uD588\uB2E4. \uB108\uD55C\uD14C \uAC78\uB9AC\uBA74 \uCC3D\uD53C\uD574\uC11C."
    - speaker: "\uB098"
      text: "\uAC78\uB9AC\uAE30 \uC2EB\uC5B4\uC11C \uADF8\uB9CC\uB454 \uAC70\uBA74, \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574."
    - speaker: "\uB808\uC628"
      text: "\uD558! \uC774\uC0C1\uD55C \uCE6D\uCC2C\uC774\uAD70. \u2026\uACE0\uB9D9\uB2E4."
  - title: "\uC9C4\uC9DC \uC774\uB984"
    minAffinity: 85
    lines:
    - speaker: "\uB808\uC628"
      text: "\uAC00\uBB38\uC5D0 \uD3B8\uC9C0\uB97C \uC37C\uB2E4. \uCC98\uC74C\uC73C\uB85C, \uB0B4\uAC00 \uBA3C\uC800."
    - speaker: "\uB808\uC628"
      text: "'\uC800\uB294 \uB808\uC628\uC785\uB2C8\uB2E4. \uC544\uC2A4\uD14C\uB974\uB97C \uB5BC\uACE0 \uBD88\uB7EC\uB3C4 \uB418\uB294, \uC774 \uB9C8\uC744\uC758 \uC740\uAE09 \uC804\uC0AC\uC785\uB2C8\uB2E4.'"
    - speaker: "\uB808\uC628"
      text: "\uB2F5\uC7A5\uC774 \uC62C\uC9C0\uB294 \uBAA8\uB974\uACA0\uAD70. \u2026\uADF8\uB798\uB3C4 \uC18D\uC740 \uD6C4\uB828\uD558\uB2E4."
    - speaker: "\uB808\uC628"
      text: "\uADF8\uB7EC\uB2C8 \uC811\uC218\uC6D0. \uC55E\uC73C\uB85C\uB294 \uADF8\uB0E5 \uB808\uC628\uC774\uB77C\uACE0 \uBD88\uB7EC \uB2E4\uC624."
