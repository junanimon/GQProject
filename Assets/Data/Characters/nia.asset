  m_Name: nia
  m_EditorClassIdentifier: Assembly-CSharp:GuildProto:NamedCharacterData
  displayName: "\uB2C8\uC544"
  epithet: "\uC232\uC5D0\uC11C \uC628 \uC5EC\uC6B0"
  rank: 0
