  look:
    label: "\uB2C8\uC544"
    body: {fileID: -3258488434072765268, guid: e01656b88637d914e97afee27e51b310, type: 3}
    portrait: {fileID: -5054113088179883950, guid: 90e122d33ae46d5469f905e70ce7badb, type: 3}
