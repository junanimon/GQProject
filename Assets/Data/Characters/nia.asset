  startAffinity: 45
  level: 3
  profile: "\uB9D0\uC218\uAC00 \uC801\uC740 \uC5EC\uC6B0 \uC218\uC778 \uAD81\uC218. \uC232 \uC774\uC57C\uAE30\uB9CC \uB098\uC624\uBA74 \uADC0\uAC00 \uCAD1\uAE0B \uC120\uB2E4."
  secret: "\uBD81\uCABD \uC232 '\uC740\uBE5B \uC5EC\uC6B0 \uC77C\uC871' \uCD9C\uC2E0. \uBD04\uC5D0 \uBD80\uC871\uC774 \uBB34\uC5B8\uAC00\uC5D0 \uCAD3\uACA8 \uD558\uB8FB\uBC24 \uC0AC\uC774 \uD769\uC5B4\uC84C\uB2E4. \uB291\uB300\uB4E4\uC774 \uB9C8\uC744\uB85C \uB0B4\uB824\uC624\uB294 \uC774\uC720(\uC232 \uAE4A\uC740 \uACF3\uC758 \uBB34\uC5B8\uAC00)\uB97C \uC5B4\uB834\uD48B\uC774 \uC54C\uACE0 \uC788\uB2E4. \uCD5C\uC885 \uC704\uD611\uC758 \uB5A1\uBC25 \uB2F4\uB2F9."
  greed: 0.1
  forgeryTendency: 0
  greetings:
  - "\u2026\uC758\uB8B0. \uC232 \uCABD \uAC70."
  - "(\uADC0\uAC00 \uCAD1\uAE0B) \u2026\uC774\uAC70."
  - "\u2026\uC548\uB155."
  thanks:
  - "\u2026\uACE0\uB9C8\uC6CC."
  - "(\uAF2C\uB9AC\uAC00 \uC0B4\uB791\uC778\uB2E4)"
  rejected:
  - "\u2026\uADF8\uB798."
  - "(\uADC0\uAC00 \uCD95 \uCC98\uC9C4\uB2E4)"
  caught:
  - "\u2026\uBBF8\uC548."
  returnSuccess:
  - "\u2026\uB05D\uB0AC\uC5B4. \uC99D\uAC70, \uC5EC\uAE30."
  - "\uC232\uC774 \uC870\uAE08 \uC870\uC6A9\uD574\uC84C\uC5B4."
  returnFail:
  - "\u2026\uC232\uC774, \uC774\uC0C1\uD574. \uC804\uBCF4\uB2E4 \uB354."
  chats:
  - "\u2026\uB291\uB300\uB4E4\uC774 \uB0B4\uB824\uC624\uB294 \uAC74, \uCAD3\uACA8\uC11C\uC57C."
  - "\uB9C8\uC744 \uBE75, \uB9DB\uC788\uC5B4. \u2026\uD2B9\uD788 \uD55C\uB098\uB124."
  events:
  - title: "\uCAD3\uACA8 \uB0B4\uB824\uC624\uB294 \uAC83\uB4E4"
    minAffinity: 55
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uB2C8\uC544"
      text: "\u2026\uB291\uB300\uB4E4. \uC694\uC998 \uB9C8\uC744\uB85C \uB0B4\uB824\uC624\uC9C0."
    - speaker: "\uB098"
      text: "\uC751. \uC758\uB8B0\uAC00 \uBD80\uCA4D \uB298\uC5C8\uC5B4."
    - speaker: "\uB2C8\uC544"
      text: "\uC0AC\uB0E5\uD558\uB7EC \uC624\uB294 \uAC70 \uC544\uB0D0. \u2026\uB3C4\uB9DD\uCCD0 \uC624\uB294 \uAC70\uC57C."
    - speaker: "\uB098"
      text: "\uB3C4\uB9DD? \uBB34\uC5C7\uC73C\uB85C\uBD80\uD130?"
    - speaker: "\uB2C8\uC544"
      text: "(\uADC0\uAC00 \uB4A4\uB85C \uC816\uD600\uC9C4\uB2E4) \u2026\uC232 \uAE4A\uC740 \uB370\uC11C, \uB098\uBB34\uAC00 \uC6B8\uC5B4. \uADF8\uAC83\uBC16\uC5D0 \uBAB0\uB77C."
  - title: "\uBD80\uC871\uC758 \uD45C\uC2DD"
    minAffinity: 70
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uB2C8\uC544\uAC00 \uC18C\uB9E4\uB97C \uAC77\uC5B4 \uD314\uC758 \uD478\uB978 \uBB38\uC2E0\uC744 \uBCF4\uC5EC \uC8FC\uC5C8\uB2E4."
    - speaker: "\uB2C8\uC544"
      text: "\uC6B0\uB9AC \uBD80\uC871 \uD45C\uC2DD. \uBD81\uCABD \uC232, \uC740\uBE5B \uC5EC\uC6B0 \uC77C\uC871."
    - speaker: "\uB2C8\uC544"
      text: "\uBD04\uC5D0 \uB2E4 \uD769\uC5B4\uC84C\uC5B4. \uBC24\uC5D0 \uC232\uC774 \uC870\uC6A9\uD574\uC9C0\uB354\uB2C8, \uC544\uCE68\uC5D4 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uC5B4."
    - speaker: "\uB2C8\uC544"
      text: "\uB098\uB9CC \uB0A8\uC544\uC11C \uB9C8\uC744\uB85C \uC654\uC5B4. \u2026\uB204\uAC00 \uC0B4\uC544 \uC788\uB294\uC9C0, \uCC3E\uC73C\uB824\uACE0."
    - speaker: "\uB098"
      text: "\uCC3E\uB294 \uAC70 \uB3C4\uC6B8\uAC8C. \uC232 \uCABD \uC758\uB8B0\uB294 \uB108\uD55C\uD14C \uBA3C\uC800 \uBCF4\uC5EC \uC904\uAC8C."
    - speaker: "\uB2C8\uC544"
      text: "(\uAF2C\uB9AC\uAC00 \uD06C\uAC8C \uD754\uB4E4\uB9B0\uB2E4) \u2026\uC57D\uC18D."
  - title: "\uD63C\uC790 \uBCF4\uB0B4\uC9C0 \uB9C8"
    minAffinity: 85
    minWeek: 1
    stopsForgery: 0
    lines:
    - speaker: "\uB2C8\uC544"
      text: "\uC811\uC218\uC6D0. \uC5B8\uC820\uAC00 \uBD81\uCABD \uC232\uC73C\uB85C \uAC00\uB294 \uC758\uB8B0\uAC00 \uC62C \uAC70\uC57C."
    - speaker: "\uB2C8\uC544"
      text: "\uADF8\uB54C \uB098 \uD63C\uC790 \uBCF4\uB0B4\uC9C0 \uB9C8. \uB098\uB294\u2026 \uC544\uB9C8 \uBA48\uCD94\uC9C0 \uC54A\uC744 \uAC70\uB2C8\uAE4C."
    - speaker: "\uB098"
      text: "\uADF8\uB7FC \uD30C\uD2F0\uB97C \uAFB8\uB824\uC11C \uBCF4\uB0BC\uAC8C. \uC81C\uB300\uB85C \uB3CC\uC544\uC62C \uC218 \uC788\uAC8C."
    - speaker: "\uB2C8\uC544"
      text: "\u2026\uC751. \uADF8\uB7EC\uBA74, \uB3CC\uC544\uC62C\uAC8C. \uC5EC\uAE30\uB85C."
  - title: "\uBE75 \uBC18\uCABD"
    minAffinity: 45
    minWeek: 2
    stopsForgery: 0
    lines:
    - speaker: 
      text: "\uB9C8\uAC10 \uB4A4, \uCC3D\uAD6C \uC704\uC5D0 \uC885\uC774\uC5D0 \uC2FC \uAFC0\uBE75 \uBC18\uCABD\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
    - speaker: "\uB2C8\uC544"
      text: "\u2026\uADF8\uAC70. \uB108 \uAC70."
    - speaker: "\uB2C8\uC544"
      text: "\uD560\uBA38\uB2C8\uAC00 \uADF8\uB7AC\uC5B4. \uBA39\uC744 \uAC74 \uBC18\uC740 \uB0A8\uACA8\uB77C. \uB0B4\uC77C\uC758 \uB108\uB97C \uC704\uD574."
    - speaker: "\uB2C8\uC544"
      text: "\uADFC\uB370 \uB0B4\uC77C\uC758 \uB098\uB294\u2026 \uC5EC\uAE30 \uC788\uC744 \uAC70\uB2C8\uAE4C. \uBC18\uC740 \uB108 \uC918\uB3C4 \uB3FC."
    - speaker: 
      text: "\uAF2C\uB9AC\uAC00 \uD55C \uBC88, \uCC9C\uCC9C\uD788 \uD754\uB4E4\uB838\uB2E4."
  - title: "\uC5D0\uB4DC\uAC70\uC758 \uAC80"
    minAffinity: 60
    minWeek: 4
    stopsForgery: 0
    lines:
    - speaker: "\uB2C8\uC544"
      text: "\uC232 \uAC00\uC7A5\uC790\uB9AC\uC5D0\uC11C \uC774\uAC70 \uC8FC\uC6E0\uC5B4."
    - speaker: 
      text: "\uBD80\uB7EC\uC9C4 \uAC80 \uC190\uC7A1\uC774. \uAC00\uC8FD\uB048\uC774 \uB0AF\uC120 \uB9E4\uB4ED\uC73C\uB85C \uBB36\uC5EC \uC788\uB2E4."
    - speaker: "\uB2C8\uC544"
      text: "\uC774 \uB9E4\uB4ED, \uC6B0\uB9AC \uBD80\uC871 \uAC70\uC57C. \uADFC\uB370 \uAC80\uC740 \uC778\uAC04 \uAC70."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "(\uB6F0\uC5B4 \uB4E4\uC5B4\uC624\uBA70) \uADF8\uAC70\u2026 \uD615 \uAC80\uC774\uC5D0\uC694! \uC190\uC7A1\uC774\uC5D0 \uAE01\uD78C \uC790\uAD6D, \uC81C\uAC00 \uC5B4\uB9B4 \uB54C \uB0B8 \uAC70\uC608\uC694!"
    - speaker: "\uB2C8\uC544"
      text: "\u2026\uB124 \uD615, \uC6B0\uB9AC \uC0AC\uB78C\uB4E4\uC774\uB791 \uAC19\uC774 \uC788\uC5C8\uB358 \uAC70\uC57C."
    - speaker: "\uC62C\uB9AC\uBC84"
      text: "\uADF8\uB7FC\u2026 \uD615\uC740 \uD63C\uC790\uAC00 \uC544\uB2C8\uC5C8\uB358 \uAC70\uB124\uC694."
    - speaker: "\uB2C8\uC544"
      text: "\uC751. \uB458 \uB2E4 \uC232 \uAE4A\uC740 \uB370 \uC788\uC5B4. \uAC19\uC774 \uCC3E\uC790. \u2026\uC57D\uC18D."
